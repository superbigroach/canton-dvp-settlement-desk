{
  "name": "@crossdesk/signer",
  "version": "0.1.0",
  "description": "CrossDesk reference signer service: evaluates a seat's named conditions from your own systems and confirms or refuses fixings with evidence.",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test",
    "check": "node dist/index.js --check"
  },
  "dependencies": {
    "express": "4.21.2",
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.6",
    "typescript": "5.6.3"
  }
}
