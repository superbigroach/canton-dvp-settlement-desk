-- Test.daml
-- ===========================================================================
-- DAML SCRIPT scenarios for the Canton DvP Settlement Desk. Run them all with:
--
--     daml test
--
-- Daml Script runs against a ledger (the in-memory one under `daml test`, or a
-- real Canton ledger under `daml script`). It can allocate parties, submit
-- commands, and QUERY what each party can see — which is exactly how we PROVE the
-- privacy model, not merely assert it in prose.
--
-- Assertion helpers used below:
--   submit p cmds          — p submits; MUST succeed (else the test fails).
--   submitMustFail p cmds  — p submits; MUST fail   (proves a guard/limit works).
--   query @T p             — the contracts of template T that p can SEE (privacy probe).
--   queryContractId p cid  — Some c if p can SEE cid, else None.
--   (===) / assertMsg      — fail the script if a predicate is false.
--
-- END-TO-END COVERAGE:
--   testInstrumentAndHolding — reference data + mint/transfer/split/merge.
--   testBilateralDvP         — Alice buys AAPL from Bob for USD, atomically.
--   testMarketOnClose        — a sealed-order MOC auction: many orders → one
--                              uniform close price DISCOVERED from the book →
--                              atomic BATCH settlement.
--   testPriceDiscoveryUnit   — the uncross as PURE arithmetic: max volume, then
--                              min imbalance, then market pressure, then the
--                              anchor. No ledger, no parties — just the algorithm.
--   testPriceDiscoveryBeatsReference — the headline: the auction prints where the
--                              BOOK crosses, NOT at the operator's reference (at
--                              which nothing would have traded at all).
--   testCompleteBookRequired — the operator OMITS one order to move the print by
--                              5 points; the completeness assertion rejects the
--                              close. Padding the list with a duplicate fails too.
--   testCancellationKeepsTheBookHonest — a withdrawal and a venue clear adjust the
--                              count, so the honest close still runs afterwards.
--   testMarketOnCloseImbalance — an over-subscribed side is rationed at the one
--                              close price; the residual does not settle (and the
--                              excess supply drags the print DOWN).
--   testAllocationUnit       — THE ALLOCATION RULE as pure arithmetic: orders priced
--                              THROUGH the print fill in full, only the marginal
--                              level is rationed, dust rounds to zero without
--                              exploding, and every allocation sums EXACTLY to the
--                              crossed volume.
--   testMixedSurplusTieBreak — Xetra §11.1.1 step 4(a): with bid surplus below and
--                              ask surplus above, the print is narrowed to the
--                              BOUNDARY pair before the anchor gets a vote — which
--                              is what keeps "better-priced fills in full" feasible.
--   testDustDoesNotAbortTheClose — one dust-sized heavy-side order used to take the
--                              WHOLE auction down. Now the close prints, the dust
--                              order is cancelled on close, and its owner keeps
--                              every unit it committed.
--   testFillsMatchReceipts   — delivered amounts EQUAL receipt amounts for every
--                              filled order, including the last in the list; the
--                              rounding residual lands by the published rule.
--   testPriceCollar          — the collar CLAMPS the print into the band around the
--                              anchor (percentage OR absolute floor, whichever is
--                              greater) and the close still prints. A book crossing
--                              ABOVE the band prints at the upper boundary, and the
--                              crossed volume is re-scored there — smaller, with the
--                              excess returned to its trader intact. (This test used
--                              to assert an ABORT; bounding the price is what the
--                              rulebooks do, and cancelling handed one participant a
--                              denial of service on everyone else's close.)
--   testCollarClampsDown     — the mirror image: a book crossing BELOW the band
--                              prints at the lower boundary.
--   testUnpricedBuyFundedAtClampedBoundary — the tightest reservation case there is:
--                              an MOC buy filling IN FULL at a CLAMPED upper
--                              boundary, minted exactly its reservation and spending
--                              every cent of it.
--   testInBandPrintIsNotClamped — the no-regression guard: inside the band (edges
--                              included) the clamp is the identity and an ordinary
--                              close never notices the collar.
--   testMocClassPriority     — Nasdaq Rule 4754(b)(3) rung (A): an UNPRICED MOC buy
--                              fills AHEAD of a limit order sitting at the print.
--                              Class beats price.
--   testAllUnpricedBookPrintsAtAnchor — MOC against MOC carries no price information,
--                              so the book prints at the ANCHOR (Xetra §11.1.1 step
--                              5; Euronext §3.1).
--   testMocLocLadderEndToEnd — the full ladder on one book: unpriced fills in full,
--                              through-the-print priced fills in full, the
--                              at-the-print level is the only one rationed.
--   testUnpricedBuyFundedAboveTheAnchor — THE CRUX. An unpriced buy is funded when
--                              the print lands ABOVE the anchor, because it reserved
--                              at the TOP OF THE COLLAR — the highest price the close
--                              can legally print.
--   testUnpricedInterestRationedProRata — unpriced interest larger than the whole
--                              cross rations AMONG THE UNPRICED, and every limit
--                              order behind them gets nothing.
--   testMocIsNeverAwayFromTheCross — an unpriced sell trades at a print far below
--                              where a limit would have stopped it, while a limited
--                              sell beside it is cancelled away from the cross.
--   testDarkPoolPrivacy      — a non-party (and even a rival participant) cannot
--                              see a resting sealed order.
--   testAtomicRollback       — a bad leg rolls the WHOLE settlement back.
--   testAgentInitiatedDvP    — an agent settles cETH within a ledger-enforced mandate.
--   testDesignatedLiquidityProvider — SELECTIVE imbalance disclosure: the DLP (and
--                              venue) see the NET book imbalance; a normal trader
--                              does NOT; the DLP sees only the aggregate (not the
--                              individual orders); the DLP offsets to clear the cross.
-- ===========================================================================

module Test where

import Daml.Script
import DA.Assert ((===))
import DA.List (head)
import DA.Optional (isNone, isSome)
import DA.Time (addRelTime, hours, days, seconds)

import Instrument
import Holding
import Settlement
import MarketOnClose
import Agent
import Governance
import Basket
import LiquidityMandate

-- Instrument ids — keep string literals consistent across scenarios.
aapl : Text
aapl = "DEMO:AAPL"

usdc : Text
usdc = "USDC"

ceth : Text
ceth = "cETH"

cbtc : Text
cbtc = "CBTC"

-- ---------------------------------------------------------------------------
-- Shared party set. `daml.yaml`'s init-script (Test:initialize) reuses this so
-- `daml start` also has parties ready for the Navigator UI.
-- ---------------------------------------------------------------------------
data Parties = Parties
  with
    issuer  : Party   -- registrar/obligor for the tokenised instruments (stands in for onRails + a bank)
    venue   : Party   -- the Market-on-Close auction operator (the exchange)
    alice   : Party   -- trader
    bob     : Party   -- trader
    bank    : Party   -- another trader / liquidity provider
    auditor : Party   -- compliance observer of settlements (need-to-know)
    agent   : Party   -- Alice's authorised trading agent (the agentic angle)
    eve     : Party   -- OUTSIDER: party to nothing (the privacy control)

setup : Script Parties
setup = do
  issuer  <- allocatePartyByHint (PartyIdHint "Issuer")
  venue   <- allocatePartyByHint (PartyIdHint "Venue")
  alice   <- allocatePartyByHint (PartyIdHint "Alice")
  bob     <- allocatePartyByHint (PartyIdHint "Bob")
  bank    <- allocatePartyByHint (PartyIdHint "Bank")
  auditor <- allocatePartyByHint (PartyIdHint "Auditor")
  agent   <- allocatePartyByHint (PartyIdHint "Agent")
  eve     <- allocatePartyByHint (PartyIdHint "Eve")
  pure (Parties issuer venue alice bob bank auditor agent eve)

-- ---------------------------------------------------------------------------
-- submitOrder / submitMocOrder — lodge one sealed order and THREAD THE AUCTION
-- FORWARD. Two helpers, one per ORDER TYPE.
-- ---------------------------------------------------------------------------
-- `SubmitOrder` is CONSUMING now: the auction carries the book count that makes
-- the close provably complete, so every submission archives the auction and
-- re-creates it with the count incremented, returning (new auction cid, order
-- cid). Every caller — these scripts and the desk's backend alike — has to carry
-- the new cid to the next call. That is the contention cost, made visible.
--
-- `limitPrice` is `Optional Decimal` on the choice. `submitOrder` takes a Decimal
-- and wraps it in `Some` — a LIMIT-ON-CLOSE, which is every order in the scripts
-- that predate the MOC work. `submitMocOrder` passes `None` — an UNPRICED
-- MARKET-ON-CLOSE, which takes no price argument because it does not have one.
submitOrder :
  ContractId ClosingAuction -> Party -> Side -> Decimal -> Decimal -> ContractId Holding
  -> Script (ContractId ClosingAuction, ContractId SealedOrder)
submitOrder auctionCid trader side quantity limitPrice holdingCid =
  submit trader do
    exerciseCmd auctionCid SubmitOrder with
      trader; side; quantity; limitPrice = Some limitPrice; holdingCid

-- An UNPRICED MOC: no limit argument, because an MOC does not have a limit. It buys
-- (or sells) the close, whatever the close turns out to be.
submitMocOrder :
  ContractId ClosingAuction -> Party -> Side -> Decimal -> ContractId Holding
  -> Script (ContractId ClosingAuction, ContractId SealedOrder)
submitMocOrder auctionCid trader side quantity holdingCid =
  submit trader do
    exerciseCmd auctionCid SubmitOrder with
      trader; side; quantity; limitPrice = None; holdingCid

-- ---------------------------------------------------------------------------
-- liveMandateOf — re-read a provider's CURRENT LiquidityMandate cid.
-- ---------------------------------------------------------------------------
-- `PublishImbalance` consumes the mandate (it stamps what the provider was shown
-- onto it, via `NoteDisclosure`) and returns only the disclosure cid, so a venue
-- that publishes twice to the same provider must re-read that provider's mandate in
-- between. It is the same cid-threading discipline `SubmitOrder` imposes on the
-- auction, and this helper is how these scripts pay it.
liveMandateOf : Party -> Script (ContractId LiquidityMandate)
liveMandateOf provider = do
  ms <- query @LiquidityMandate provider
  case filter (\(_, m) -> m.provider == provider) ms of
    ((cid, _) :: _) -> pure cid
    []              -> abort "no live mandate for this provider"

-- Publish the three tokenised instruments (the reference-data layer). onRails is
-- the real cETH issuer on Devnet — here one `issuer` stands in for all three.
setupInstruments : Party -> Script ()
setupInstruments issuer = do
  _ <- submit issuer do
    createCmd Instrument with
      issuer; depository = issuer; id = aapl; version = "1"
      kind = "Equity"; description = "Demo tokenised equity (AAPL-like)"
      referencePrice = Some 255.0
  _ <- submit issuer do
    createCmd Instrument with
      issuer; depository = issuer; id = usdc; version = "1"
      kind = "Cash"; description = "Tokenised USD cash (USDC demo token) / bank deposit"
      referencePrice = None
  _ <- submit issuer do
    createCmd Instrument with
      issuer; depository = issuer; id = ceth; version = "1"
      kind = "CryptoWrapped"; description = "Wrapped ETH on Canton (onRails cETH)"
      referencePrice = Some 2400.0
  _ <- submit issuer do
    createCmd Instrument with
      issuer; depository = issuer; id = cbtc; version = "1"
      kind = "CryptoWrapped"; description = "Wrapped BTC on Canton (cBTC)"
      referencePrice = Some 65000.0
  pure ()

-- Mint a holding to `owner` (only the issuer signs).
mint : Party -> Text -> Party -> Decimal -> Script (ContractId Holding)
mint issuer instrumentId owner amount =
  submit issuer do createCmd Holding with issuer; instrumentId; owner; amount; disclosedTo = []

-- Total units of `inst` that party `p` currently owns (sums over holdings p sees).
ownedAmount : Party -> Text -> Script Decimal
ownedAmount p inst = do
  hs <- query @Holding p
  pure $ foldl
    (\acc (_, h) -> if h.instrumentId == inst && h.owner == p then acc + h.amount else acc)
    0.0 hs

-- ---------------------------------------------------------------------------
-- initialize — the `daml start` init-script. Allocates parties, publishes the
-- instruments, seeds holdings, and posts a live DvP proposal so you can log into
-- Navigator as Alice and Accept, then as Bob and Settle.
-- ---------------------------------------------------------------------------
initialize : Script ()
initialize = do
  Parties{..} <- setup
  setupInstruments issuer

  -- Bob (the SELLER) holds 10 AAPL; Alice (the BUYER) holds 2,550 USD.
  bobAapl   <- mint issuer aapl bob   10.0
  aliceCash <- mint issuer usdc  alice 2550.0

  -- Crypto-wrapped inventory for the cETH + CBTC desks. Both Alice and Bob carry
  -- a starting book so the blotter shows real cETH/CBTC/USDC positions and either
  -- party can settle or send a crypto leg to the opening/closing cross.
  _ <- mint issuer ceth alice 5.0       -- Alice: 5 cETH  (~12,000 USDC @ 2,400)
  _ <- mint issuer ceth bob   4.0       -- Bob:   4 cETH
  _ <- mint issuer cbtc alice 1.0       -- Alice: 1 CBTC  (~65,000 USDC)
  _ <- mint issuer cbtc bob   2.0       -- Bob:   2 CBTC
  _ <- mint issuer usdc bob   50000.0   -- Bob: working USDC cash for crypto buys
  _ <- mint issuer usdc alice 150000.0  -- Alice: working USDC cash for crypto buys

  -- Bank is the DESIGNATED LIQUIDITY PROVIDER for the auctions (see the auto-opened
  -- auction in the backend, which sets liquidityProvider = Bank). It must carry a
  -- deep book on BOTH legs so it can offset a net imbalance on whichever side the
  -- book is heavy: sell the asset into a buy-heavy book, or buy it in a sell-heavy
  -- one. Give it inventory across every instrument plus ample cash.
  _ <- mint issuer aapl bank 500.0      -- Bank: 500 AAPL to sell into buy-heavy AAPL closes
  _ <- mint issuer ceth bank 100.0      -- Bank: 100 cETH liquidity
  _ <- mint issuer cbtc bank 20.0       -- Bank: 20 CBTC liquidity
  _ <- mint issuer usdc bank 2000000.0  -- Bank: 2,000,000 USDC to buy into sell-heavy books

  -- Bob proposes to sell 10 AAPL for 2,550 USD (255.0 each). Alice is counterparty.
  _ <- submit bob do
    createCmd DvPProposal with
      proposer = bob
      counterparty = alice
      auditor
      assetHoldingCid = bobAapl
      cashHoldingCid = aliceCash
      assetInstrument = aapl
      assetAmount = 10.0
      cashInstrument = usdc
      cashAmount = 2550.0
  pure ()

-- ---------------------------------------------------------------------------
-- TEST 1 — Reference data + holding lifecycle.
-- ---------------------------------------------------------------------------
testInstrumentAndHolding : Script ()
testInstrumentAndHolding = do
  Parties{..} <- setup
  setupInstruments issuer

  -- Mint 3 cETH to Alice; only the issuer signs.
  cethCid <- mint issuer ceth alice 3.0

  -- Alice transfers the cETH to Bob. No consent from Bob needed: the successor
  -- is issuer-signed (delegated) and Bob merely becomes the new observer/holder.
  cethCid2 <- submit alice do exerciseCmd cethCid Transfer with newOwner = bob
  Some now <- queryContractId bob cethCid2
  now.owner        === bob
  now.instrumentId === ceth
  now.amount       === 3.0
  archived <- queryContractId alice cethCid
  assertMsg "original cETH holding must be archived after transfer" (isNone archived)

  -- Split and merge (the partial-fill primitive).
  bigCid <- mint issuer aapl alice 10.0
  (deliverCid, changeCid) <- submit alice do exerciseCmd bigCid Split with splitAmount = 4.0
  Some d <- queryContractId alice deliverCid
  Some c <- queryContractId alice changeCid
  d.amount === 4.0
  c.amount === 6.0
  mergedCid <- submit alice do exerciseCmd deliverCid Merge with otherCid = changeCid
  Some m <- queryContractId alice mergedCid
  m.amount === 10.0
  -- Over-splitting must fail.
  submitMustFail alice do exerciseCmd mergedCid Split with splitAmount = 99.0

-- ---------------------------------------------------------------------------
-- TEST 2 — Bilateral atomic DvP: Alice buys AAPL from Bob paying USD.
-- Both legs move in ONE transaction; a bilateral audit receipt is written in the
-- same tx; the auditor sees the receipt but NOT the underlying holdings.
-- ---------------------------------------------------------------------------
testBilateralDvP : Script ()
testBilateralDvP = do
  Parties{..} <- setup

  bobAapl   <- mint issuer aapl bob   10.0    -- Bob (seller) delivers the asset
  aliceCash <- mint issuer usdc  alice 2550.0  -- Alice (buyer) delivers the cash

  -- Bob proposes; Alice + the auditor are observers.
  propCid <- submit bob do
    createCmd DvPProposal with
      proposer = bob; counterparty = alice; auditor
      assetHoldingCid = bobAapl; cashHoldingCid = aliceCash
      assetInstrument = aapl; assetAmount = 10.0
      cashInstrument = usdc;   cashAmount = 2550.0

  -- PRIVACY: Alice sees the proposal (observer); so does the auditor.
  assertMsg "buyer must see the proposal"  . isSome =<< queryContractId alice propCid
  assertMsg "auditor must see the proposal" . isSome =<< queryContractId auditor propCid

  -- Alice ACCEPTS -> a bilaterally-signed agreement; Bob SETTLES -> atomic swap.
  agreeCid <- submit alice do exerciseCmd propCid Accept
  res      <- submit bob   do exerciseCmd agreeCid Settle

  -- Ownership swapped, amounts preserved.
  Some aaplNow <- queryContractId alice res.deliveredAsset
  aaplNow.owner  === alice
  aaplNow.amount === 10.0
  Some cashNow <- queryContractId bob res.deliveredCash
  cashNow.owner  === bob
  cashNow.amount === 2550.0

  -- AUDIT: the auditor sees the receipt (the trade)...
  Some receipt <- queryContractId auditor res.receipt
  receipt.assetAmount === 10.0
  receipt.cashAmount  === 2550.0
  receipt.unitPrice   === 255.0

  -- ...but NOT the underlying holdings (issuer + owner only). Need-to-know.
  assertMsg "auditor must NOT see the delivered asset" . isNone =<< queryContractId auditor res.deliveredAsset
  assertMsg "auditor must NOT see the delivered cash"  . isNone =<< queryContractId auditor res.deliveredCash

  -- OUTSIDER: Eve sees nothing and cannot settle someone else's trade.
  assertMsg "outsider must not see the asset holding" . isNone =<< queryContractId eve bobAapl

-- ---------------------------------------------------------------------------
-- TEST 3 — Market-on-Close: a sealed-order call auction that settles a BATCH
-- of crosses atomically at ONE closing price.
-- ---------------------------------------------------------------------------
-- Book (all AAPL, cash in USD; sealed — nobody sees anyone else's order):
--   SELL  Bob    10 @ 250      BUY  Alice 10 @ 260  (commits 2,600 USD)
--   SELL  Carol   8 @ 253      BUY  Dave   8 @ 256  (commits 2,048 USD)
-- The venue's published ANCHOR is 255.0. The uncross scores every candidate:
--   250 → 10 traded | 253 → 18 | 255 → 18 | 256 → 18 | 260 → 10
-- Maximum volume is 18, tied at {253, 255, 256}; all three are perfectly balanced
-- (imbalance 0), so market pressure has nothing to say and the anchor breaks the
-- tie: the auction prints 255. Both pairs cross in full at that one price.
-- ---------------------------------------------------------------------------
testMarketOnClose : Script ()
testMarketOnClose = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  -- Sellers pre-hold the asset; buyers pre-hold cash to commit. A buy reserves at
  -- its OWN LIMIT (the most it can ever owe now that the print is discovered), so
  -- Dave commits 8 × 256 = 2,048 and gets the difference back as change.
  bobAsset   <- mint issuer aapl bob   10.0
  carolAsset <- mint issuer aapl carol 8.0
  aliceCash  <- mint issuer usdc  alice 2600.0
  daveCash   <- mint issuer usdc  dave  2048.0

  -- The venue opens the auction for AAPL with four registered participants and
  -- publishes its anchor (255.0, the AAPL reference price). The anchor is NOT the
  -- print: it is one candidate among the book's limits, and the last tie-break.
  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"
      referencePrice = 255.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  -- Each participant lodges a SEALED order, pre-committing its holding. Each
  -- submission returns the re-created auction (the book count went up by one).
  (a1, bobSell)   <- submitOrder auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, carolSell) <- submitOrder a1         carol Sell  8.0 253.0 carolAsset
  (a3, aliceBuy)  <- submitOrder a2         alice Buy  10.0 260.0 aliceCash
  (a4, daveBuy)   <- submitOrder a3         dave  Buy   8.0 256.0 daveCash

  -- DARK POOL: even a registered participant cannot see a RIVAL's sealed order.
  assertMsg "Carol must NOT see Alice's sealed order" . isNone =<< queryContractId carol aliceBuy
  assertMsg "Bob must NOT see Dave's sealed order"     . isNone =<< queryContractId bob daveBuy

  -- The operator seals the window, then runs the close over the COMPLETE book
  -- (4 submitted, 0 cancelled → all 4 must be supplied). The uncross prints 255
  -- and crosses min(18, 18) = 18, so every order fills in full, in ONE atomic tx.
  closedCid <- submit venue do exerciseCmd a4 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy, daveBuy]
      sellOrders = [bobSell, carolSell]

  -- The batch prints at 255.0 with a fill record per filled order (2 buys +
  -- 2 sells = 4); the auditor sees it.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 4
  -- EVERY fill printed at the ONE uniform closing price.
  assertMsg "all fills must print at the uniform closing price"
    (all (\f -> f.price == 255.0) batch.fills)

  -- Post-close ownership: buyers hold the asset, sellers hold the cash.
  aliceAapl <- ownedAmount alice aapl
  daveAapl  <- ownedAmount dave  aapl
  bobUsd    <- ownedAmount bob   usdc
  carolUsd  <- ownedAmount carol usdc
  aliceAapl === 10.0            -- Alice bought 10 AAPL
  daveAapl  === 8.0             -- Dave bought 8 AAPL
  bobUsd    === 2550.0          -- Bob sold 10 @ 255
  carolUsd  === 2040.0          -- Carol sold 8 @ 255
  -- Alice committed 2,600 USD but paid 2,550 — 50 USD change returned to her.
  aliceUsd <- ownedAmount alice usdc
  aliceUsd === 50.0

-- ---------------------------------------------------------------------------
-- TEST 3a — OPENING CROSS (Market-on-Open / MOO): the SAME sealed uniform-price
-- auction run as an OPENING session. The crossing logic is identical to the
-- close; only `session = "Open"` differs, so the printed uniform price is the
-- OFFICIAL OPEN. Crossed on cETH to exercise a CryptoWrapped instrument.
--
-- Bob offers at 2,350, Alice bids 2,500 — the book crosses anywhere in between, so
-- every candidate trades the full 3 with zero imbalance and the anchor (2,400)
-- takes it. A wide, balanced book is exactly where the anchor SHOULD decide.
-- ---------------------------------------------------------------------------
testOpeningCross : Script ()
testOpeningCross = do
  Parties{..} <- setup
  setupInstruments issuer

  -- Bob sells 3 cETH; Alice buys 3 cETH; both pre-commit. Alice reserves at her
  -- own limit: 3 × 2,500 = 7,500, of which she will spend 7,200.
  bobCeth   <- mint issuer ceth bob   3.0
  aliceCash <- mint issuer usdc alice 7500.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Open"
      referencePrice = 2400.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder auctionCid bob   Sell 3.0 2350.0 bobCeth
  (a2, aliceBuy) <- submitOrder a1         alice Buy  3.0 2500.0 aliceCash

  closedCid <- submit venue do exerciseCmd a2 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]

  -- The opening cross prints every fill at the ONE official open (2,400).
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 2400.0
  length batch.fills === 2
  assertMsg "all opening fills print at the uniform official open"
    (all (\f -> f.price == 2400.0) batch.fills)

  -- Post-open: Alice holds 3 cETH, Bob holds the 7,200 USDC proceeds (3 @ 2,400).
  aliceCeth <- ownedAmount alice ceth
  bobUsd    <- ownedAmount bob   usdc
  aliceCeth === 3.0
  bobUsd    === 7200.0

-- ---------------------------------------------------------------------------
-- TEST 3b — MARKET-ON-CLOSE with an IMBALANCE: the heavy side is rationed
-- PRO-RATA at the ONE uniform closing price; the light side fills in full; the
-- unmatched residual does NOT settle. And, now, the excess supply DRAGS THE PRINT
-- DOWN — the market-pressure tie-break doing its job on a real book.
-- ---------------------------------------------------------------------------
-- Book (all AAPL, cash USD; sealed):
--   BUY  Alice 10 @ 260  (commits 2,600 USD)   BUY  Bank 10 @ 258 (commits 2,580 USD)
--   SELL Bob   30 @ 250  (commits 30 AAPL)
-- The uncross: 20 units trade at 250, at 255 and at 258 alike (Bob's 30 is on
-- offer at all three, both bids are live at all three), and each of those prices
-- leaves the SAME 10-unit sell-side imbalance. Volume cannot separate them and
-- imbalance cannot separate them — so market pressure does: the book is SELL-heavy
-- at every surviving price, and excess supply prints at the BOTTOM of the range.
-- The close prints 250, NOT the venue's 255 anchor. That is a seller offering
-- three times what the buyers want and having to hit the low end for it — exactly
-- what a real MOC does, and exactly what an operator-supplied price would have
-- papered over.
-- totalBuy = 20, totalSell = 30  ->  matched = 20 (SELL side is heavy).
-- Buyers fill in FULL (10 each). Bob is rationed pro-rata: 30 * 20/30 = 20 filled,
-- 10 left UNFILLED (stays as his holding).
-- ---------------------------------------------------------------------------
testMarketOnCloseImbalance : Script ()
testMarketOnCloseImbalance = do
  Parties{..} <- setup
  setupInstruments issuer

  -- One big seller vs two smaller buyers -> a sell-heavy imbalance. Each buyer
  -- reserves at its own limit (10 × 260 and 10 × 258).
  bobAsset  <- mint issuer aapl bob  30.0     -- Bob offers 30 AAPL
  aliceCash <- mint issuer usdc alice 2600.0
  bankCash  <- mint issuer usdc bank  2580.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"
      referencePrice = 255.0
      participants = [alice, bank, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder auctionCid bob   Sell 30.0 250.0 bobAsset
  (a2, aliceBuy) <- submitOrder a1         alice Buy  10.0 260.0 aliceCash
  (a3, bankBuy)  <- submitOrder a2         bank  Buy  10.0 258.0 bankCash

  closedCid <- submit venue do exerciseCmd a3 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy, bankBuy]
      sellOrders = [bobSell]

  -- MARKET PRESSURE: sell-heavy at every volume-maximising price -> print the
  -- lowest of them (250), not the operator's 255. Uniform on every fill;
  -- 2 buys + 1 sell = 3 fill records.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 250.0
  assertMsg "the print must be discovered, not the venue's 255 anchor"
    (batch.closingPrice /= 255.0)
  length batch.fills === 3
  assertMsg "all fills must print at the uniform closing price"
    (all (\f -> f.price == 250.0) batch.fills)
  -- Bob's single sell fill is the pro-rated 20 (of his 30), not the full 30.
  let bobFill = head (filter (\f -> f.seller == bob) batch.fills)
  bobFill.quantity === 20.0

  -- Buyers filled in FULL and hold the asset; each paid 10 @ 250 = 2,500 and got
  -- the difference between their limit and the print back as change.
  aliceAapl <- ownedAmount alice aapl
  bankAapl  <- ownedAmount bank  aapl
  aliceAapl === 10.0
  bankAapl  === 10.0
  aliceUsd <- ownedAmount alice usdc
  bankUsd  <- ownedAmount bank  usdc
  aliceUsd === 100.0     -- reserved 2,600 at her 260 limit, paid 2,500
  bankUsd  === 80.0      -- reserved 2,580 at its 258 limit, paid 2,500

  -- Bob sold the pro-rated 20 @ 250 = 5,000 USD, and KEEPS the 10 unfilled AAPL
  -- (the residual did not settle) — proving partial, rationed settlement.
  bobUsd  <- ownedAmount bob usdc
  bobAapl <- ownedAmount bob aapl
  bobUsd  === 5000.0
  bobAapl === 10.0

-- ---------------------------------------------------------------------------
-- TEST 3c — RESERVED BACKING survives a same-trader SECOND order (the fix for the
-- stale-holding CONTRACT_NOT_FOUND). One trader lodges TWO buys out of a SINGLE
-- cash holding; each order reserves its own dedicated slice, so submitting the
-- second does NOT invalidate the first, and the close crosses both without a
-- missing-contract error. Bob sells enough to fill them.
-- ---------------------------------------------------------------------------
testReservedBackingSurvivesResubmit : Script ()
testReservedBackingSurvivesResubmit = do
  Parties{..} <- setup
  setupInstruments issuer

  -- Alice has ONE 5,200 USDC holding backing BOTH of her buys (10 @ her 260 limit).
  aliceCash <- mint issuer usdc alice 5200.0
  bobAsset  <- mint issuer aapl bob   20.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  -- First buy reserves 2,600 out of Alice's single holding into a dedicated slice
  -- (disclosed to the venue); the 2,600 change stays FREE and private to Alice.
  (a1, aliceBuy1) <- submitOrder auctionCid alice Buy 10.0 260.0 aliceCash
  -- Alice still owns all 5,200 (2,600 reserved + 2,600 free) until the cross.
  aliceTotal <- ownedAmount alice usdc
  aliceTotal === 5200.0
  -- Second buy: pick Alice's FREE cash (NOT the slice already committed to the
  -- venue), exactly as the desk's provisioning does — so buy1's reserved slice is
  -- never re-consumed. This is the crux: a same-trader re-submit is safe.
  aliceFree <- head . map fst
    . filter (\(_, h) -> h.owner == alice && h.instrumentId == usdc && null h.disclosedTo)
    <$> query @Holding alice
  (a2, aliceBuy2) <- submitOrder a1 alice Buy 10.0 260.0 aliceFree
  (a3, bobSell)   <- submitOrder a2 bob   Sell 20.0 250.0 bobAsset

  -- The FIRST order's pinned holding is still valid at the close: both buys cross.
  closedCid <- submit venue do exerciseCmd a3 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy1, aliceBuy2]
      sellOrders = [bobSell]
  Some batch <- queryContractId auditor batchCid
  length batch.fills === 3     -- 2 buys + 1 sell, no CONTRACT_NOT_FOUND
  aliceAapl <- ownedAmount alice aapl
  aliceAapl === 20.0           -- Alice bought all 20 across her two orders

-- ---------------------------------------------------------------------------
-- TEST 3d — WITHDRAW + VENUE CLEAR, now THROUGH THE AUCTION so the book count
-- stays honest. A trader withdraws their own resting order (its reserved cash
-- returns to being freely theirs), and the venue can clear a resting order off the
-- book. Neither loses the trader any balance — and neither can happen BEHIND the
-- auction's back, because that is what would let a close run over a book the
-- ledger has mis-counted.
-- ---------------------------------------------------------------------------
testWithdrawAndVenueClear : Script ()
testWithdrawAndVenueClear = do
  Parties{..} <- setup
  setupInstruments issuer

  aliceCash <- mint issuer usdc alice 2600.0   -- 10 @ her 260 limit
  bobAsset  <- mint issuer aapl bob   10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy  10.0 260.0 aliceCash
  (a2, bobSell)  <- submitOrder a1         bob   Sell 10.0 250.0 bobAsset

  -- NO BACK DOOR: Alice cannot archive her own order directly. `SealedOrder.Cancel`
  -- needs the operator's authority too, and the ONLY place both authorities meet is
  -- `WithdrawOrder` — which increments `cancelledCount` in the same transaction.
  -- Without this the count would drift from the live book and the completeness
  -- assertion would be worthless.
  submitMustFail alice do exerciseCmd aliceBuy Cancel

  -- Alice WITHDRAWS her order through the auction. It is gone from the book; her
  -- 2,600 USDC is unlocked back to a free, private holding (venue no longer
  -- observes it); the auction comes back with cancelledCount = 1.
  (a3, unlocked) <- submit alice do
    exerciseCmd a2 WithdrawOrder with trader = alice; orderCid = aliceBuy
  goneA <- queryContractId venue aliceBuy
  assertMsg "withdrawn order must be archived" (isNone goneA)
  aliceUsd <- ownedAmount alice usdc
  aliceUsd === 2600.0
  Some uh <- queryContractId alice unlocked
  assertMsg "unlocked holding is private to Alice again" (null uh.disclosedTo)
  assertMsg "venue can no longer see the unlocked holding" . isNone
    =<< queryContractId venue unlocked

  -- The VENUE CLEARS Bob's resting sell off the book — on the record, through the
  -- auction (cancelledCount = 2). Bob keeps his 10 AAPL: clearing cancels the
  -- ORDER, never the balance.
  a4 <- submit venue do exerciseCmd a3 ClearOrder with orderCid = bobSell
  goneB <- queryContractId venue bobSell
  assertMsg "venue-cleared order must be archived" (isNone goneB)
  bobAapl <- ownedAmount bob aapl
  bobAapl === 10.0

  -- A trader cannot clear the book (only the operator can), and a non-owner cannot
  -- withdraw someone else's order.
  (a5, aliceBuy2) <- submitOrder a4 alice Buy 10.0 260.0 unlocked
  submitMustFail bob   do
    exerciseCmd a5 WithdrawOrder with trader = bob; orderCid = aliceBuy2   -- not the owner
  submitMustFail alice do
    exerciseCmd a5 ClearOrder with orderCid = aliceBuy2                    -- not the operator
  submitMustFail alice do exerciseCmd aliceBuy2 Cancel                     -- no back door

  -- NO-CANCEL PERIOD: once the venue seals the window, resting interest is
  -- committed. You do not get to watch the cross coming and pull out of it.
  sealed <- submit venue do exerciseCmd a5 CloseBidding
  submitMustFail alice do
    exerciseCmd sealed WithdrawOrder with trader = alice; orderCid = aliceBuy2

  -- The counts still add up: 3 submitted, 2 cancelled, 1 live order — and one
  -- lonely bid does not cross, so this close correctly refuses to print.
  submitMustFail venue do
    exerciseCmd sealed RunClose with buyOrders = [aliceBuy2]; sellOrders = []

-- ---------------------------------------------------------------------------
-- TEST 3e — THE UNCROSS AS PURE ARITHMETIC. No ledger, no parties, no holdings:
-- just the price-discovery function, one tie-break rule at a time.
-- ---------------------------------------------------------------------------
-- This is the test that would have answered the judges directly. The auction's
-- price is a FUNCTION of the book, so it can be pinned down here, exhaustively,
-- without settling anything. Every case below states the whole scoreboard —
-- price, volume, both sides' interest and the signed imbalance — so there is
-- nowhere for a wrong answer to hide.
-- ---------------------------------------------------------------------------
testPriceDiscoveryUnit : Script ()
testPriceDiscoveryUnit = do
  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      priceOf  = fmap (\c -> c.price)

  -- RULE 1 — MAXIMUM VOLUME, and it beats the reference outright.
  --   SELL 10 @ 250 | SELL 10 @ 256 | BUY 15 @ 256 | BUY 5 @ 251, anchor 260.
  --   250 → 10 trade | 251 → 10 | 256 → 15 | 260 → nothing at all.
  -- The anchor is the operator's number and it is worthless here: at 260 not one
  -- unit changes hands. The book says 256.
  let book1 = [sell 10.0 250.0, sell 10.0 256.0, buy 15.0 256.0, buy 5.0 251.0]
  discoverPrice 260.0 book1 === Some (CrossResult with
    price = 256.0; executedQty = 15.0; buyVolume = 15.0; sellVolume = 20.0; imbalance = -5.0)
  (crossAt book1 260.0).executedQty === 0.0

  -- RULE 2 — MINIMUM IMBALANCE breaks a volume tie (and outranks the anchor).
  --   BUY 10 @ 100 | SELL 10 @ 90 | SELL 10 @ 100, anchor 100.
  --   90 → 10 trade, imbalance 0 | 100 → 10 trade, imbalance −10.
  -- Same volume. The anchor sits ON 100, but 90 strands nothing, so 90 prints.
  let book2 = [buy 10.0 100.0, sell 10.0 90.0, sell 10.0 100.0]
  discoverPrice 100.0 book2 === Some (CrossResult with
    price = 90.0; executedQty = 10.0; buyVolume = 10.0; sellVolume = 10.0; imbalance = 0.0)

  -- RULE 3 — MARKET PRESSURE breaks a tie in volume AND imbalance.
  -- BUY-HEAVY: BUY 20 @ 110 | SELL 10 @ 90, anchor 95. Every price from 90 to 110
  -- trades 10 and leaves the same 10 of unfilled demand. Excess demand pays up:
  -- the print goes to the TOP of the range, 110 — not the anchor's 95.
  let book3 = [buy 20.0 110.0, sell 10.0 90.0]
  discoverPrice 95.0 book3 === Some (CrossResult with
    price = 110.0; executedQty = 10.0; buyVolume = 20.0; sellVolume = 10.0; imbalance = 10.0)
  -- SELL-HEAVY: the mirror image. Excess supply gives way, to the BOTTOM.
  let book4 = [sell 20.0 90.0, buy 10.0 110.0]
  discoverPrice 105.0 book4 === Some (CrossResult with
    price = 90.0; executedQty = 10.0; buyVolume = 10.0; sellVolume = 20.0; imbalance = -10.0)

  -- RULE 4 — NEAREST THE ANCHOR, the reference price's last remaining job.
  -- BUY 10 @ 110 | SELL 10 @ 90: a wide, perfectly balanced book that crosses at
  -- every price in between with nothing to choose between them. ONLY here does the
  -- venue's number decide — and it decides within the range the ORDERS allow.
  let book5 = [buy 10.0 110.0, sell 10.0 90.0]
  priceOf (discoverPrice 100.0 book5) === Some 100.0   -- anchor inside the range
  priceOf (discoverPrice  92.0 book5) === Some  92.0   -- same book, anchor moved
  priceOf (discoverPrice 200.0 book5) === Some 110.0   -- anchor outside: pulled to the edge

  -- NO CROSS — the bid is below the offer, so no price trades anything and there
  -- is no auction price. RunClose aborts on this and nothing settles.
  discoverPrice 100.0 [buy 10.0 90.0, sell 10.0 110.0] === None
  discoverPrice 100.0 [] === None

-- ---------------------------------------------------------------------------
-- TEST 3f — PRICE DISCOVERY BEATS THE REFERENCE, END TO END.
-- ---------------------------------------------------------------------------
-- THE HEADLINE. The venue publishes an anchor of 260 — and the auction ignores it,
-- because at 260 the book does not trade a single share. The uncross finds 256,
-- prints 15 units there, rations the heavy sell side pro-rata, and cancels the one
-- bid that sat below the print. The operator supplied the orders and nothing else.
--
-- AND — since the allocation fix — this is also the end-to-end proof of PRICE
-- PRIORITY. Twenty units of supply are offered into fifteen of demand, so the sell
-- side is rationed; but it is NOT rationed uniformly. Bob offered at 250, THROUGH
-- the 256 print, so he is guaranteed to participate and fills all 10. Carol offered
-- AT the print, so hers is the marginal level and it is the only one rationed: she
-- fills 5 of 10. Under the old pro-rata-across-all-levels rule both would have been
-- cut to 7.5 and Bob's more aggressive offer would have bought him nothing.
--
-- Book (AAPL / USDC, sealed; anchor 260):
--   SELL Bob   10 @ 250    BUY Alice 15 @ 256   (reserves 15 × 256 = 3,840)
--   SELL Carol 10 @ 256    BUY Dave   5 @ 251   (reserves  5 × 251 = 1,255)
--   250 → 10 trade | 251 → 10 | 256 → 15 | 260 → 0.   Print: 256.
-- Alice fills 15 in full; Bob fills 10 in FULL (through the print) and Carol takes
-- the 5 that is left at the marginal level; Dave's 251 bid is away from the cross
-- and does not trade.
-- ---------------------------------------------------------------------------
testPriceDiscoveryBeatsReference : Script ()
testPriceDiscoveryBeatsReference = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  bobAsset   <- mint issuer aapl bob   10.0
  carolAsset <- mint issuer aapl carol 10.0
  aliceCash  <- mint issuer usdc alice 3840.0
  daveCash   <- mint issuer usdc dave  1255.0

  -- The venue publishes 260 — deliberately away from where the book crosses.
  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 260.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)   <- submitOrder auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, carolSell) <- submitOrder a1         carol Sell 10.0 256.0 carolAsset
  (a3, aliceBuy)  <- submitOrder a2         alice Buy  15.0 256.0 aliceCash
  (a4, daveBuy)   <- submitOrder a3         dave  Buy   5.0 251.0 daveCash

  closedCid <- submit venue do exerciseCmd a4 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy, daveBuy]
      sellOrders = [bobSell, carolSell]

  -- THE PROOF: the print is 256 — the volume-maximising price — and NOT the 260
  -- the operator published.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 256.0
  assertMsg "the auction must NOT print at the operator's reference price"
    (batch.closingPrice /= 260.0)
  assertMsg "every fill prints at the ONE discovered price"
    (all (\f -> f.price == 256.0) batch.fills)
  length batch.fills === 3          -- 1 buy + 2 sells; Dave never traded

  -- Alice filled 15 in full and spent every cent she reserved (15 × 256 = 3,840).
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 15.0
  aliceUsd  === 0.0
  -- PRICE PRIORITY THROUGH THE PRINT — the headline allocation property, end to
  -- end. Bob and Carol offered 20 into 15 of demand, so the sell side IS rationed —
  -- but only at the margin. Bob's 250 offer is priced THROUGH the 256 print, so it
  -- is guaranteed to participate and fills all 10 (2,560 USDC; no AAPL left over).
  -- Carol's offer sits AT the print, which makes hers the marginal level and the
  -- only one rationed: 5 of her 10 fill (1,280 USDC) and she keeps the other 5.
  -- The old rule pro-rated the WHOLE eligible side and gave each of them 7.5 —
  -- i.e. offering 6 points cheaper bought Bob no precedence whatsoever, and the only
  -- way for either of them to get filled was to send a bigger order.
  bobUsd    <- ownedAmount bob   usdc
  carolUsd  <- ownedAmount carol usdc
  bobAapl   <- ownedAmount bob   aapl
  carolAapl <- ownedAmount carol aapl
  bobUsd    === 2560.0
  carolUsd  === 1280.0
  bobAapl   === 0.0
  carolAapl === 5.0
  -- The seller fill records say the same thing the balances do.
  let bobFill   = head (filter (\f -> f.seller == bob)   batch.fills)
      carolFill = head (filter (\f -> f.seller == carol) batch.fills)
  bobFill.quantity   === 10.0    -- through the print: filled in FULL
  carolFill.quantity === 5.0     -- at the print: the marginal level, rationed
  -- CANCEL ON CLOSE: Dave bid below the print, so his order did not trade and was
  -- cleared off the book by the close itself. He keeps every cent he committed —
  -- the archive touches the ORDER, never the balance.
  assertMsg "an away-from-the-cross order is cancelled on close" . isNone
    =<< queryContractId venue daveBuy
  daveUsd  <- ownedAmount dave usdc
  daveAapl <- ownedAmount dave aapl
  daveUsd  === 1255.0
  daveAapl === 0.0

-- ---------------------------------------------------------------------------
-- TEST 3g — THE CLOSE MUST RUN OVER THE COMPLETE BOOK.
-- ---------------------------------------------------------------------------
-- THE ATTACK, AND WHY IT PAYS. Discovering the price from the book is worth
-- nothing if the operator picks which orders go into it. Here Carol's offer of 10
-- at 240 is the cheap supply that lets the auction clear 20 units at 255. Leave it
-- out and the remaining book is buy-heavy at every price, market pressure takes
-- the print to the TOP of the range, and the close prints 260 on half the volume —
-- five points of value moved with a deletion, not a trade.
--
-- The ledger stops it by counting. `submittedCount − cancelledCount` says how many
-- orders are live; the close must be handed exactly that many, all distinct. To
-- omit Carol the venue would have to CANCEL Carol — on the ledger, where Carol
-- sees it.
-- ---------------------------------------------------------------------------
testCompleteBookRequired : Script ()
testCompleteBookRequired = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  -- The counterfactual, computed purely: the same book, with and without Carol.
  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      priceOf  = fmap (\c -> c.price)
      fullBook      = [sell 10.0 250.0, sell 10.0 240.0, buy 20.0 260.0]
      truncatedBook = [sell 10.0 250.0,                  buy 20.0 260.0]
  priceOf (discoverPrice 255.0 fullBook)      === Some 255.0
  priceOf (discoverPrice 255.0 truncatedBook) === Some 260.0
  (crossAt fullBook      255.0).executedQty === 20.0
  (crossAt truncatedBook 260.0).executedQty === 10.0

  bobAsset   <- mint issuer aapl bob   10.0
  carolAsset <- mint issuer aapl carol 10.0
  aliceCash  <- mint issuer usdc alice 5200.0   -- 20 @ her 260 limit

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)   <- submitOrder auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, carolSell) <- submitOrder a1         carol Sell 10.0 240.0 carolAsset
  (a3, aliceBuy)  <- submitOrder a2         alice Buy  20.0 260.0 aliceCash
  sealed <- submit venue do exerciseCmd a3 CloseBidding

  -- THE MOST IMPORTANT ASSERTION IN THIS FILE. The venue tries to run the close
  -- over 2 of the 3 live orders — Carol's cheap offer quietly missing. Three were
  -- submitted, none cancelled, so the arithmetic fails and NOTHING settles.
  submitMustFail venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell]

  -- AND THE OBVIOUS DODGE: pad the list back to three by supplying Bob's order
  -- twice. The count now adds up, and the distinctness check kills it.
  submitMustFail venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, bobSell]

  -- Hand over the WHOLE book and the same close runs perfectly well — proving the
  -- rejections above were the completeness rule, not a broken auction.
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, carolSell]
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0        -- the honest print, not the truncated 260
  length batch.fills === 3
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bobUsd    <- ownedAmount bob   usdc
  carolUsd  <- ownedAmount carol usdc
  aliceAapl === 20.0                  -- 20 units, twice what the truncated book cleared
  aliceUsd  === 100.0                 -- reserved 5,200 at her limit, paid 5,100
  bobUsd    === 2550.0
  carolUsd  === 2550.0

-- ---------------------------------------------------------------------------
-- TEST 3h — CANCELLATION KEEPS THE BOOK HONEST (both directions).
-- ---------------------------------------------------------------------------
-- The completeness rule would be useless if it froze the book: real auctions have
-- withdrawals, and venues do have to clear stale interest. Both are allowed —
-- both just have to happen ON THE LEDGER. Dave withdraws his own bid; the venue
-- clears Carol's far-away offer. Each increments `cancelledCount`, so the live
-- book shrinks from 4 to 2 and the honest close over those 2 runs. The count is
-- not slackened by any of it: a close over 1 is still rejected.
-- ---------------------------------------------------------------------------
testCancellationKeepsTheBookHonest : Script ()
testCancellationKeepsTheBookHonest = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  bobAsset   <- mint issuer aapl bob   10.0
  carolAsset <- mint issuer aapl carol 5.0
  aliceCash  <- mint issuer usdc alice 2600.0   -- 10 @ her 260 limit
  daveCash   <- mint issuer usdc dave  1300.0   --  5 @ his 260 limit

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)   <- submitOrder auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, aliceBuy)  <- submitOrder a1         alice Buy  10.0 260.0 aliceCash
  (a3, daveBuy)   <- submitOrder a2         dave  Buy   5.0 260.0 daveCash
  (a4, carolSell) <- submitOrder a3         carol Sell  5.0 300.0 carolAsset
  -- 4 submitted, 0 cancelled.

  -- DAVE WITHDRAWS his own bid through the auction: order archived, his 1,300 USDC
  -- unlocked back to him, cancelledCount = 1.
  (a5, daveUnlocked) <- submit dave do
    exerciseCmd a4 WithdrawOrder with trader = dave; orderCid = daveBuy
  assertMsg "the withdrawn order is off the book" . isNone
    =<< queryContractId venue daveBuy
  Some du <- queryContractId dave daveUnlocked
  assertMsg "withdrawn backing is the trader's again, and private" (null du.disclosedTo)

  -- THE VENUE CLEARS Carol's stale 300 offer — nowhere near the market, and it
  -- would only sit in the book unfilled. On the record: cancelledCount = 2.
  a6 <- submit venue do exerciseCmd a5 ClearOrder with orderCid = carolSell
  assertMsg "the cleared order is off the book" . isNone
    =<< queryContractId venue carolSell

  sealed <- submit venue do exerciseCmd a6 CloseBidding

  -- The count did not go slack: 4 submitted − 2 cancelled = 2 live orders, and a
  -- close handed only one of them is still rejected.
  submitMustFail venue do
    exerciseCmd sealed RunClose with buyOrders = []; sellOrders = [bobSell]

  -- Handed both, the honest close prints 255 and settles.
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 2

  -- Everyone ends where they should: Alice bought 10, Bob sold 10 at 255, and the
  -- two cancelled traders kept every unit and every cent they had committed.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bobUsd    <- ownedAmount bob   usdc
  daveUsd   <- ownedAmount dave  usdc
  carolAapl <- ownedAmount carol aapl
  aliceAapl === 10.0
  aliceUsd  === 50.0        -- reserved 2,600 at her limit, paid 2,550
  bobUsd    === 2550.0
  daveUsd   === 1300.0
  carolAapl === 5.0

-- ---------------------------------------------------------------------------
-- TEST 4 — DARK-POOL PRIVACY: an outsider (Eve) sees no order, no holding, no
-- batch — and cannot settle anything.
-- ---------------------------------------------------------------------------
testDarkPoolPrivacy : Script ()
testDarkPoolPrivacy = do
  Parties{..} <- setup

  aliceCash <- mint issuer usdc alice 2600.0
  bobAsset  <- mint issuer aapl bob  10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"
      referencePrice = 255.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (a1, aliceBuy) <- submitOrder auctionCid alice Buy 10.0 260.0 aliceCash

  -- Eve is party to NOTHING. From her participant these contracts do not exist.
  eveOrders   <- query @SealedOrder eve
  eveHoldings <- query @Holding eve
  eveAuction  <- queryContractId eve a1
  assertMsg "outsider must see zero sealed orders" (null eveOrders)
  assertMsg "outsider must see zero holdings"      (null eveHoldings)
  assertMsg "outsider must not see the auction"    (isNone eveAuction)

  -- Eve cannot move a holding she can't see (Bob's asset, still live and private),
  -- nor cancel into the sealed book. (Alice's cash was consumed when she pledged
  -- it into her sealed order — allocated to the venue, not to Eve.)
  submitMustFail eve do exerciseCmd bobAsset Transfer with newOwner = eve
  submitMustFail eve do exerciseCmd aliceBuy Cancel

-- ---------------------------------------------------------------------------
-- TEST 5 — ATOMIC ROLLBACK: a leg precondition fails, so the WHOLE settlement
-- rolls back. No principal risk — the seller keeps his asset.
-- ---------------------------------------------------------------------------
testAtomicRollback : Script ()
testAtomicRollback = do
  Parties{..} <- setup

  bobAapl   <- mint issuer aapl bob   10.0
  -- Alice's cash is only 2,500 — but the proposal states a price of 2,550.
  aliceCash <- mint issuer usdc  alice 2500.0
  propCid <- submit bob do
    createCmd DvPProposal with
      proposer = bob; counterparty = alice; auditor
      assetHoldingCid = bobAapl; cashHoldingCid = aliceCash
      assetInstrument = aapl; assetAmount = 10.0
      cashInstrument = usdc;   cashAmount = 2550.0   -- disagrees with the actual 2,500

  -- Accept ALLOCATES (discloses) the cash leg to the proposer — that re-creates
  -- Alice's cash holding under a new contract id (same owner, same 2,500 amount),
  -- which is an allocation, NOT a settlement move.
  agreeCid <- submit alice do exerciseCmd propCid Accept
  -- Settle asserts cash.amount == cashAmount (2500 /= 2550) -> whole tx aborts.
  submitMustFail bob do exerciseCmd agreeCid Settle

  -- Nothing SETTLED: Bob still owns his (untouched) AAPL, and Alice still holds
  -- her full 2,500 USD (checked by balance, since the allocation re-issued the
  -- cash holding under a fresh id).
  Some aaplStill <- queryContractId bob bobAapl
  aaplStill.owner  === bob
  aaplStill.amount === 10.0
  aliceUsd <- ownedAmount alice usdc
  aliceUsd === 2500.0
  bobUsd <- ownedAmount bob usdc
  bobUsd === 0.0                    -- Bob received no cash: the swap did not happen

-- ---------------------------------------------------------------------------
-- TEST 6 — AGENT-INITIATED DvP within a mandate limit (settling cETH).
-- Alice grants an Agent a mandate to sell up to 3 cETH. An over-limit attempt
-- fails; a within-limit attempt creates a proposal that then settles atomically.
-- ---------------------------------------------------------------------------
testAgentInitiatedDvP : Script ()
testAgentInitiatedDvP = do
  Parties{..} <- setup

  aliceCeth0 <- mint issuer ceth alice 2.0     -- Alice's 2 cETH to sell
  bobCash    <- mint issuer usdc  bob   5000.0  -- Bob's cash to pay

  -- Alice ALLOCATES the cETH to her Agent: she discloses the holding so the agent
  -- can reference/validate it inside InitiateDvP (the mandate carries Alice's
  -- AUTHORITY, but the agent still needs VISIBILITY of the specific holding).
  aliceCeth <- submit alice do exerciseCmd aliceCeth0 Disclose with newObserver = agent

  -- Alice delegates: the Agent may initiate cETH settlements up to 3 cETH.
  mandateCid <- submit alice do
    createCmd TradingMandate with
      principal = alice; agent; instrument = ceth; maxAmount = 3.0

  -- OVER-LIMIT: a 4 cETH holding breaches the 3 cETH cap -> must fail. Alice
  -- allocates it to the agent too, so the rejection is genuinely the mandate
  -- limit (not a visibility error).
  bigCeth0 <- mint issuer ceth alice 4.0
  bigCeth  <- submit alice do exerciseCmd bigCeth0 Disclose with newObserver = agent
  submitMustFail agent do
    exerciseCmd mandateCid InitiateDvP with
      counterparty = bob; auditor
      assetHoldingCid = bigCeth; cashHoldingCid = bobCash
      assetAmount = 4.0; cashInstrument = usdc; cashAmount = 5000.0

  -- WITHIN LIMIT: the Agent initiates a valid 2 cETH settlement on Alice's behalf.
  propCid <- submit agent do
    exerciseCmd mandateCid InitiateDvP with
      counterparty = bob; auditor
      assetHoldingCid = aliceCeth; cashHoldingCid = bobCash
      assetAmount = 2.0; cashInstrument = usdc; cashAmount = 5000.0

  -- The proposal names Alice as proposer — Bob never sees the agent.
  Some prop <- queryContractId bob propCid
  prop.proposer     === alice
  prop.counterparty === bob

  -- Bob accepts; Alice (the proposer) settles the agent-initiated trade.
  agreeCid <- submit bob   do exerciseCmd propCid  Accept
  res      <- submit alice do exerciseCmd agreeCid Settle
  Some cethNow <- queryContractId bob res.deliveredAsset
  cethNow.owner  === bob
  cethNow.amount === 2.0
  Some cashNow <- queryContractId alice res.deliveredCash
  cashNow.owner  === alice
  cashNow.amount === 5000.0

-- ---------------------------------------------------------------------------
-- TEST 7 — MANDATED LIQUIDITY PROVIDER: selective net-imbalance disclosure, but
--          only to a party that has TAKEN ON AN OBLIGATION to absorb it.
-- ---------------------------------------------------------------------------
-- LIQUIDITY WITHOUT LEAKAGE, AND WITHOUT A FREE LUNCH. A lit auction publishes its
-- imbalance to the whole market (leaking it to front-runners); a dark pool leaks
-- nothing but risks a no-fill. Canton does BOTH: reveal the NET imbalance to a
-- committed provider, and to nobody else.
--
-- WHAT THIS TEST NOW PROVES THAT IT DID NOT BEFORE. The auction is still created
-- with `liquidityProvider = Some bank` — the old hand-picked designation — and that
-- field BUYS BANK NOTHING. Bank sees no imbalance until it accepts published
-- `MandateTerms` and signs a `LiquidityMandate` binding it to absorb up to 5 units
-- within 500bps of the anchor. The privilege is now the input to a duty.
--
-- Book (AAPL, cash USDC, anchor 255, sealed):
--   BUY  Alice 2 @ 260   →  net BUY imbalance of 2 (no sells yet).
-- We PROVE:
--   * with the field set but NO mandate, Bank sees nothing;
--   * once mandated, Bank SEES "Net BUY 2 @ 255"; the venue sees it too;
--   * Bank sees ONLY the aggregate — NOT Alice's individual sealed order;
--   * Carol (a normal registered trader, equally eligible, simply hasn't accepted)
--     sees NEITHER the imbalance NOR the order;
--   * Bank offsets by SELLING 2; the republished imbalance is now Flat; the close
--     crosses cleanly (Alice +2 AAPL, Bank +510 USDC).
-- ---------------------------------------------------------------------------
testDesignatedLiquidityProvider : Script ()
testDesignatedLiquidityProvider = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  now <- getTime

  aliceCash <- mint issuer usdc alice 600.0   -- reserves 2 @ her 260 limit (= 520)
  bankAsset <- mint issuer aapl bank  10.0    -- the provider's inventory to offset with

  -- The venue opens the auction. It still writes the LEGACY designation field — and
  -- that is deliberate here, because the test's job is to show the field is inert.
  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bank, carol]
      liquidityProvider = Some bank
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  -- Alice lodges a sealed BUY of 2. The book is now net BUY 2.
  (a1, aliceBuy) <- submitOrder auctionCid alice Buy 2.0 260.0 aliceCash

  -- THE FIELD BUYS NOTHING. Bank is named `liquidityProvider` on a live auction with
  -- a real imbalance resting in it, and holds no disclosure whatsoever.
  namedButUnmandated <- query @ImbalanceDisclosure bank
  assertMsg "the legacy liquidityProvider field must NOT disclose anything by itself"
    (null namedButUnmandated)

  -- THE VENUE POSTS OPEN TERMS to its whole participant roster. No fee, no ranking:
  -- Alice, Bank and Carol are offered identical terms and any of them may take them.
  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 5.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bank, carol]
      accepted = []; barred = []

  -- Bank takes up the seat — and takes on the obligation. Note who controls this:
  -- the PROVIDER. The venue posted the offer; it did not choose the taker.
  (_terms1, bankMandate) <- submit bank do
    exerciseCmd termsCid AcceptTerms with provider = bank

  -- Only NOW does the venue have a party it may publish the residual to.
  discCid <- submit venue do
    exerciseCmd a1 PublishImbalance with restingOrders = [aliceBuy]; mandateCid = bankMandate

  -- THE DLP SEES THE AGGREGATE: net BUY of 2 at the reference price.
  Some disc <- queryContractId bank discCid
  disc.netSide     === "Buy"
  disc.netQuantity === 2.0
  disc.referencePrice === 255.0
  disc.liquidityProvider === bank
  -- The venue (operator) sees it too.
  assertMsg "venue must see the imbalance disclosure" . isSome =<< queryContractId venue discCid

  -- SELECTIVE: the DLP sees ONLY the aggregate — NOT Alice's individual order.
  assertMsg "DLP must NOT see the individual sealed order (aggregate only)"
    . isNone =<< queryContractId bank aliceBuy

  -- A normal registered trader (Carol) sees NEITHER the imbalance NOR the order.
  carolSeesImbalance <- query @ImbalanceDisclosure carol
  assertMsg "a normal trader must NOT see any imbalance disclosure" (null carolSeesImbalance)
  assertMsg "a normal trader must NOT see a rival's sealed order"
    . isNone =<< queryContractId carol aliceBuy

  -- THE PROVIDER PERFORMS: Bank lodges a sealed SELL of 2 (the opposite side) to
  -- clear the cross. Its order is as private as any other.
  (a2, bankSell) <- submitOrder a1 bank Sell 2.0 250.0 bankAsset

  -- The venue republishes: the book is now balanced (Flat). Note the re-read — the
  -- first publication consumed the mandate to stamp what Bank was shown onto it.
  bankMandate2 <- liveMandateOf bank
  discCid2 <- submit venue do
    exerciseCmd a2 PublishImbalance with
      restingOrders = [aliceBuy, bankSell]; mandateCid = bankMandate2
  Some disc2 <- queryContractId bank discCid2
  disc2.netSide     === "Flat"
  disc2.netQuantity === 0.0

  -- Run the close: the offsetting orders cross cleanly. Bank offers at 250, Alice
  -- bids 260, so every candidate trades the full 2 with no imbalance and the
  -- anchor decides — the print is 255.
  closedCid <- submit venue do exerciseCmd a2 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bankSell]
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 2

  -- Alice bought 2 AAPL for 510 (90 change); the provider sold 2 AAPL for 510 USDC.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bankAapl  <- ownedAmount bank  aapl
  bankUsd   <- ownedAmount bank  usdc
  aliceAapl === 2.0
  aliceUsd  === 90.0
  bankAapl  === 8.0
  bankUsd   === 510.0

  -- THE OBLIGATION KEPT A RECORD OF THE PRIVILEGE. The mandate now carries what Bank
  -- was shown — the PEAK imbalance (2, buy-side), and that it was opened twice. That
  -- stamp is what `RecordPerformance` scores against, and it was written in the same
  -- transactions as the disclosures themselves.
  bankMandate3 <- liveMandateOf bank
  Some mFinal  <- queryContractId bank bankMandate3
  mFinal.peakShownQty    === 2.0
  mFinal.shownSide       === "Buy"
  mFinal.disclosuresSeen === 2
  assertMsg "the mandate must record WHEN it was last shown the book" (isSome mFinal.lastShownAt)

  -- PRIVACY GUARD: an outsider cannot ask the venue to disclose the imbalance to
  -- itself — PublishImbalance is operator-controlled, and only a MANDATED provider
  -- observes the result.
  pure ()

-- ---------------------------------------------------------------------------
-- TEST 7a — THE SEAT IS CONTESTABLE: an open offer, taken by whoever wants it.
-- ---------------------------------------------------------------------------
-- THE CRITICISM THIS ANSWERS. `liquidityProvider : Optional Party` was ONE slot,
-- filled by the venue, uncontested. Hu & Murphy (2026, Management Science 72(5))
-- measure the harm of exactly that shape of channel at NYSE and locate it where high
-- fees INHIBIT COMPETITION for the privileged seat — so the remedy is not a better
-- appointment, it is an open, cheap, plural entry.
--
-- WHAT IS PROVED HERE:
--   * the terms are published to the whole participant roster and any of them may
--     accept — Bank and Carol both do, off the SAME offer, at no cost;
--   * both hold live mandates AT THE SAME TIME on identical terms (same size, same
--     band, same expiry) — nobody got a better deal for being chosen;
--   * an outsider who is not on the venue's roster CANNOT accept;
--   * nobody can hold two mandates off one set of terms (double-dipping the seat).
-- ---------------------------------------------------------------------------
testMandateSeatIsContestable : Script ()
testMandateSeatIsContestable = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  now <- getTime

  -- The venue posts ONE open offer to its whole registered roster.
  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 5.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bank, carol]
      accepted = []; barred = []

  -- EVERY eligible participant can SEE the offer. An open offer nobody can read is
  -- not an open offer, so visibility is part of the contestability.
  aliceSeesTerms <- query @MandateTerms alice
  carolSeesTerms <- query @MandateTerms carol
  assertMsg "every eligible participant must see the open terms" (length aliceSeesTerms == 1)
  assertMsg "every eligible participant must see the open terms" (length carolSeesTerms == 1)

  -- AN OUTSIDER CANNOT TAKE THE SEAT. Eve is not on the venue's roster.
  submitMustFail eve do exerciseCmd termsCid AcceptTerms with provider = eve

  -- TWO DIFFERENT PARTICIPANTS TAKE THE SAME OFFER. Bank first, then Carol — off the
  -- successor terms, because acceptance is recorded on the ledger.
  (terms1, bankMandate)  <- submit bank  do exerciseCmd termsCid AcceptTerms with provider = bank
  (terms2, carolMandate) <- submit carol do exerciseCmd terms1  AcceptTerms with provider = carol

  -- BOTH MANDATES ARE LIVE AT ONCE, ON IDENTICAL TERMS. This is the plurality that
  -- one `Optional Party` could not express.
  Some bankM  <- queryContractId bank  bankMandate
  Some carolM <- queryContractId carol carolMandate
  bankM.provider  === bank
  carolM.provider === carol
  bankM.commitmentSize === carolM.commitmentSize
  bankM.maxBandBps     === carolM.maxBandBps
  bankM.expiresAt      === carolM.expiresAt
  bankM.anchorPrice    === 255.0

  -- The venue co-signs every one of them: the obligation is bilateral, not a name in
  -- a field the counterparty never agreed to.
  assertMsg "a mandate must be signed by the venue AND the provider"
    (bankM.operator == venue && bankM.provider == bank)

  -- Both takers are on the record, and NOBODY is barred: entry cost is zero.
  Some t2 <- queryContractId venue terms2
  assertMsg "both providers must be recorded as holding the seat"
    (bank `elem` t2.accepted && carol `elem` t2.accepted)
  assertMsg "nobody is barred from an offer nobody has failed" (null t2.barred)

  -- YOU CANNOT TAKE THE SAME SEAT TWICE off one set of terms.
  submitMustFail bank do exerciseCmd terms2 AcceptTerms with provider = bank

  -- And Alice — an ordinary trader, not a bank — is equally entitled to it. The
  -- eligibility test is the trading roster and nothing else.
  assertMsg "eligibility is the trading roster: no special status required"
    (alice `elem` t2.eligible)

-- ---------------------------------------------------------------------------
-- TEST 7b — TWO LIVE MANDATES, BOTH SHOWN THE SAME IMBALANCE.
-- ---------------------------------------------------------------------------
-- Plurality is only worth something if the venue actually has to show the number to
-- ALL of the obligated providers rather than picking a favourite among them. Bank
-- and Carol both hold mandates; both are published to; both read the same residual.
-- And — the privacy property survives the plurality — neither can see the OTHER's
-- disclosure, nor the sealed order that produced it.
-- ---------------------------------------------------------------------------
testTwoLiveMandatesBothSeeTheImbalance : Script ()
testTwoLiveMandatesBothSeeTheImbalance = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  now <- getTime

  aliceCash <- mint issuer usdc alice 3000.0   -- 10 @ her 260 limit = 2,600

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bank, carol]
      liquidityProvider = None      -- NOTHING is designated; the mandate is the gate
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 6.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bank, carol]
      accepted = []; barred = []

  (terms1, bankMandate)  <- submit bank  do exerciseCmd termsCid AcceptTerms with provider = bank
  (_t2,    carolMandate) <- submit carol do exerciseCmd terms1  AcceptTerms with provider = carol

  -- One 10-lot buy rests in the book: a net BUY imbalance of 10.
  (a1, aliceBuy) <- submitOrder auctionCid alice Buy 10.0 260.0 aliceCash

  -- The venue publishes to BOTH obligated providers. One call per mandate, so every
  -- disclosure is tied to a specific obligation.
  bankDisc  <- submit venue do
    exerciseCmd a1 PublishImbalance with restingOrders = [aliceBuy]; mandateCid = bankMandate
  carolDisc <- submit venue do
    exerciseCmd a1 PublishImbalance with restingOrders = [aliceBuy]; mandateCid = carolMandate

  -- BOTH SEE THE SAME NUMBER.
  Some bd <- queryContractId bank  bankDisc
  Some cd <- queryContractId carol carolDisc
  bd.netSide === "Buy"
  cd.netSide === "Buy"
  bd.netQuantity === 10.0
  cd.netQuantity === 10.0
  bd.referencePrice === 255.0

  -- BUT NOT EACH OTHER'S — a provider is not shown who else is standing behind the
  -- book, only what the book needs. Competition without a view of the competitor.
  assertMsg "one provider must NOT see another provider's disclosure"
    . isNone =<< queryContractId bank carolDisc
  assertMsg "one provider must NOT see another provider's disclosure"
    . isNone =<< queryContractId carol bankDisc
  -- And neither sees the sealed order itself: the aggregate, and nothing but.
  assertMsg "a mandated provider still sees only the AGGREGATE"
    . isNone =<< queryContractId bank aliceBuy
  assertMsg "a mandated provider still sees only the AGGREGATE"
    . isNone =<< queryContractId carol aliceBuy

  -- Both obligations recorded the look independently.
  bm <- liveMandateOf bank
  cm <- liveMandateOf carol
  Some bmC <- queryContractId bank  bm
  Some cmC <- queryContractId carol cm
  bmC.peakShownQty === 10.0
  cmC.peakShownQty === 10.0

-- ---------------------------------------------------------------------------
-- TEST 7c — NO MANDATE, NO NUMBER. The privilege cannot be had without the duty.
-- ---------------------------------------------------------------------------
-- The sharpest single assertion in this module. The auction is created with the
-- LEGACY `liquidityProvider = Some bank` field set — the exact designation that used
-- to be sufficient — and Bank, holding no mandate for this book, is shown NOTHING,
-- while Carol, who accepted the same open terms Bank could have accepted, is shown
-- the residual. The privilege moved from a field to an obligation.
--
-- It also proves the gate is BOOK-SCOPED: Bank holds a real, live, signed mandate —
-- for the cETH close — and it buys it nothing at the AAPL close.
-- ---------------------------------------------------------------------------
testNoMandateNoImbalance : Script ()
testNoMandateNoImbalance = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  now <- getTime

  aliceCash <- mint issuer usdc alice 600.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bank, carol]
      liquidityProvider = Some bank   -- the LEGACY designation, deliberately set
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy 2.0 260.0 aliceCash

  -- Bank accepts a mandate for a DIFFERENT BOOK (the cETH close). A genuine, live,
  -- co-signed obligation — just not one about this instrument.
  cethTerms <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; anchorPrice = 2400.0
      commitmentSize = 5.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bank, carol]
      accepted = []; barred = []
  (_ct, bankCethMandate) <- submit bank do
    exerciseCmd cethTerms AcceptTerms with provider = bank

  -- THE GATE HOLDS: a mandate for another book discloses nothing here.
  submitMustFail venue do
    exerciseCmd a1 PublishImbalance with
      restingOrders = [aliceBuy]; mandateCid = bankCethMandate

  -- Carol takes the AAPL terms and IS shown the number.
  aaplTerms <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 5.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bank, carol]
      accepted = []; barred = []
  (_at, carolMandate) <- submit carol do
    exerciseCmd aaplTerms AcceptTerms with provider = carol
  carolDisc <- submit venue do
    exerciseCmd a1 PublishImbalance with restingOrders = [aliceBuy]; mandateCid = carolMandate
  Some cd <- queryContractId carol carolDisc
  cd.netSide     === "Buy"
  cd.netQuantity === 2.0

  -- AND THE NAMED PARTY STILL HAS NOTHING. Bank is `liquidityProvider` on this very
  -- auction and holds no AAPL disclosure at all.
  bankDiscs <- query @ImbalanceDisclosure bank
  assertMsg "the legacy designation must grant NO sight of this book's imbalance"
    (null (filter (\(_, d) -> d.instrumentId == aapl) bankDiscs))
  assertMsg "an unmandated party must not see the mandated provider's disclosure"
    . isNone =<< queryContractId bank carolDisc

  -- A third party with no mandate at all sees nothing either — the control case.
  eveDiscs <- query @ImbalanceDisclosure eve
  assertMsg "a party with no mandate sees no imbalance anywhere" (null eveDiscs)

-- ---------------------------------------------------------------------------
-- TEST 7d — AN EXPIRED MANDATE STOPS THE DISCLOSURE.
-- ---------------------------------------------------------------------------
-- An obligation that has run out is not an obligation, so it cannot buy sight of the
-- book. The same mandate is published to successfully BEFORE its expiry and rejected
-- AFTER it, with nothing changed but the clock — and the expired terms can no longer
-- be re-accepted to manufacture a fresh one.
-- ---------------------------------------------------------------------------
testExpiredMandateStopsDisclosure : Script ()
testExpiredMandateStopsDisclosure = do
  Parties{..} <- setup
  setupInstruments issuer
  now <- getTime

  aliceCash <- mint issuer usdc alice 600.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bank]
      liquidityProvider = None
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  -- Terms that lapse in one hour.
  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 5.0; maxBandBps = 500
      expiresAt = addRelTime now (hours 1)
      eligible = [alice, bank]
      accepted = []; barred = []
  (terms1, bankMandate) <- submit bank do exerciseCmd termsCid AcceptTerms with provider = bank

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy 2.0 260.0 aliceCash

  -- WHILE LIVE: the disclosure works.
  disc1 <- submit venue do
    exerciseCmd a1 PublishImbalance with restingOrders = [aliceBuy]; mandateCid = bankMandate
  Some d1 <- queryContractId bank disc1
  d1.netQuantity === 2.0

  -- THE CLOCK MOVES PAST THE EXPIRY. Nothing else about the book changes.
  passTime (hours 2)

  -- THE SAME MANDATE NOW DISCLOSES NOTHING.
  bankMandate2 <- liveMandateOf bank
  submitMustFail venue do
    exerciseCmd a1 PublishImbalance with
      restingOrders = [aliceBuy]; mandateCid = bankMandate2

  -- And it cannot be topped up: the expired terms cannot be re-accepted either, so a
  -- lapsed provider cannot walk straight back into the seat without new terms.
  submitMustFail alice do exerciseCmd terms1 AcceptTerms with provider = alice

  -- The provider still holds no NEW disclosure — its last look is the one it took
  -- while the obligation was live.
  bankDiscs <- query @ImbalanceDisclosure bank
  length bankDiscs === 1

-- ---------------------------------------------------------------------------
-- TEST 7e — A PROVIDER THAT MEETS ITS COMMITMENT IS RECORDED AS HAVING MET IT.
-- ---------------------------------------------------------------------------
-- The accountability half. Bank is shown a buy-side imbalance of 8, is committed to
-- 8, sells 8 into the close, and the ledger records committed / owed / delivered /
-- met against the batch that actually printed. Its mandate SURVIVES — a provider
-- that performs keeps the seat for the rest of the session — and nobody is barred.
--
-- Book: Alice BUY 10 @ 260, Bob SELL 2 @ 250, Bank (mandated) SELL 8 @ 250.
-- Every candidate crosses the full 10 with zero imbalance, so the anchor decides and
-- the print is 255 — comfortably inside Bank's 1000bps band.
-- ---------------------------------------------------------------------------
testMandateMetIsRecorded : Script ()
testMandateMetIsRecorded = do
  Parties{..} <- setup
  setupInstruments issuer
  now <- getTime

  aliceCash <- mint issuer usdc alice 3000.0   -- 10 @ 260 = 2,600 reserved
  bobAsset  <- mint issuer aapl bob   2.0
  bankAsset <- mint issuer aapl bank  20.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, bank]
      liquidityProvider = None
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 8.0; maxBandBps = 1000
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bob, bank]
      accepted = []; barred = []
  (terms1, bankMandate) <- submit bank do exerciseCmd termsCid AcceptTerms with provider = bank

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy  10.0 260.0 aliceCash
  (a2, bobSell)  <- submitOrder a1         bob   Sell  2.0 250.0 bobAsset

  -- The venue opens the book to its obligated provider: net BUY 8.
  disc <- submit venue do
    exerciseCmd a2 PublishImbalance with
      restingOrders = [aliceBuy, bobSell]; mandateCid = bankMandate
  Some d <- queryContractId bank disc
  d.netSide     === "Buy"
  d.netQuantity === 8.0

  -- THE PROVIDER PERFORMS: it sells the 8 it undertook to absorb.
  (a3, bankSell) <- submitOrder a2 bank Sell 8.0 250.0 bankAsset

  closedCid <- submit venue do exerciseCmd a3 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, bankSell]
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0

  -- SCORE IT. The venue records performance against the batch that printed.
  bankMandate2 <- liveMandateOf bank
  outcome <- submit venue do
    exerciseCmd bankMandate2 RecordPerformance with batchCid; termsCid = terms1

  Some perf <- queryContractId auditor outcome.performance
  perf.provider   === bank
  perf.shownSide  === "Buy"
  perf.shownQty   === 8.0
  perf.committed  === 8.0
  perf.owed       === 8.0
  perf.delivered  === 8.0     -- its contra-side (SELL) fills in the batch
  perf.met        === True
  perf.withinBand === True
  perf.printedPrice === 255.0
  -- The record points AT the batch, so the auditor can recompute the arithmetic
  -- instead of taking the venue's word for it.
  perf.batchRef === batchCid

  -- THE PROVIDER SEES ITS OWN SCORECARD; so does the auditor. A rival does not.
  assertMsg "a provider must see its own performance record"
    . isSome =<< queryContractId bank outcome.performance
  assertMsg "a rival must NOT see another provider's performance record"
    . isNone =<< queryContractId bob outcome.performance

  -- THE MANDATE SURVIVES — performance keeps the seat — and nobody is barred.
  assertMsg "a mandate that MET its commitment must survive the close"
    (isSome outcome.mandate)
  Some tAfter <- queryContractId venue outcome.terms
  assertMsg "a provider that met its commitment must NOT be barred"
    (null tAfter.barred)
  assertMsg "a provider that met its commitment keeps its seat"
    (bank `elem` tAfter.accepted)

  -- And it was paid for standing in: 8 AAPL sold at the 255 print.
  bankUsd <- ownedAmount bank usdc
  bankUsd === 2040.0

-- ---------------------------------------------------------------------------
-- TEST 7f — A PROVIDER THAT FAILS IS RECORDED, REVOKED, AND BARRED.
-- ---------------------------------------------------------------------------
-- THE TEETH. Same book, same disclosure, same commitment — and Bank does nothing
-- with what it was shown. The close prints anyway (Alice's 10-lot bid crosses Bob's
-- 2 at 260, the residual goes unfilled), and the ledger records the failure, revokes
-- the mandate, bars the provider from these terms for this session, and refuses the
-- re-acceptance. This is what makes the disclosure a bargain rather than a gift.
-- ---------------------------------------------------------------------------
testFailedMandateIsRevokedAndBarred : Script ()
testFailedMandateIsRevokedAndBarred = do
  Parties{..} <- setup
  setupInstruments issuer
  now <- getTime

  aliceCash <- mint issuer usdc alice 3000.0
  bobAsset  <- mint issuer aapl bob   2.0
  _bankInv  <- mint issuer aapl bank  20.0    -- it HAD the inventory; it just sat on it

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, bank]
      liquidityProvider = None
      fixingRef = None
      submittedCount = 0; cancelledCount = 0
      isOpen = True

  termsCid <- submit venue do
    createCmd MandateTerms with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; anchorPrice = 255.0
      commitmentSize = 8.0; maxBandBps = 1000
      expiresAt = addRelTime now (hours 24)
      eligible = [alice, bob, bank]
      accepted = []; barred = []
  (terms1, bankMandate) <- submit bank do exerciseCmd termsCid AcceptTerms with provider = bank

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy  10.0 260.0 aliceCash
  (a2, bobSell)  <- submitOrder a1         bob   Sell  2.0 250.0 bobAsset

  -- Bank is shown the residual it undertook to absorb: net BUY 8.
  disc <- submit venue do
    exerciseCmd a2 PublishImbalance with
      restingOrders = [aliceBuy, bobSell]; mandateCid = bankMandate
  Some d <- queryContractId bank disc
  d.netQuantity === 8.0

  -- ...AND DOES NOTHING. The close runs over the book as it stands: every candidate
  -- trades 2 with a bid surplus of 8, so market pressure prints at the top (260).
  closedCid <- submit venue do exerciseCmd a2 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell]
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 260.0

  bankMandate2 <- liveMandateOf bank
  outcome <- submit venue do
    exerciseCmd bankMandate2 RecordPerformance with batchCid; termsCid = terms1

  -- 1. THE FAILURE IS RECORDED, with the arithmetic that produced it.
  Some perf <- queryContractId auditor outcome.performance
  perf.shownSide  === "Buy"
  perf.shownQty   === 8.0
  perf.committed  === 8.0
  perf.withinBand === True     -- 260 is inside 255 ± 1000bps: no excuse there
  perf.owed       === 8.0
  perf.delivered  === 0.0
  perf.met        === False

  -- 2. THE MANDATE IS REVOKED — there is no surviving obligation contract.
  assertMsg "a failed mandate must be REVOKED" (isNone outcome.mandate)
  bankMandates <- query @LiquidityMandate bank
  assertMsg "a revoked provider must hold no live mandate" (null bankMandates)

  -- 3. THE PROVIDER IS BARRED for this session, on the terms themselves.
  Some tAfter <- queryContractId venue outcome.terms
  assertMsg "a failed provider must be barred from these terms" (bank `elem` tAfter.barred)
  assertMsg "a failed provider must lose its recorded seat"     (bank `notElem` tAfter.accepted)

  -- 4. AND IT CANNOT SIMPLY TAKE THE SEAT AGAIN. This is the assert that makes the
  --    consequence real rather than decorative.
  submitMustFail bank do exerciseCmd outcome.terms AcceptTerms with provider = bank

  -- The bar is EVIDENCE-GATED, not administrative: a provider that MET its
  -- commitment cannot be barred even by the venue that signs the terms. Bob never
  -- held a mandate and has no failure record, so there is nothing to bar him with —
  -- and Bank's record cannot be re-used against him either.
  submitMustFail venue do
    exerciseCmd outcome.terms BarProvider with
      provider = bob; performanceCid = outcome.performance

-- ---------------------------------------------------------------------------
-- TEST 8 — DECENTRALISED OPERATOR: a K-of-N committee-attested NAV fixing.
-- ---------------------------------------------------------------------------
-- The official price must not be any single party's number. A 2-of-3 committee
-- proves it: the proposer ALONE cannot finalise; a non-member cannot confirm; only
-- once a SECOND distinct member attests does an official NavFixing exist — and its
-- signatory set IS the attestors, so K-of-N is provable from the contract itself.
-- ---------------------------------------------------------------------------
testThresholdAttestation : Script ()
testThresholdAttestation = do
  Parties{..} <- setup
  setupInstruments issuer

  -- A 3-member committee (venue, bank, agent), threshold 2; issuer administers it.
  let members = [venue, bank, agent]
  committeeCid <- submit issuer do
    createCmd OperatorCommittee with
      admin = issuer; members; threshold = 2; auditor
      label = "Lucilla NAV Committee"

  -- A member (venue) proposes the cETH close fix @ 2,400. It is the first attestor.
  propCid <- submit venue do
    exerciseCmd committeeCid ProposeFixing with
      proposer = venue; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; price = 2400.0; rationale = "uniform sealed-cross VWAP"

  -- A NON-member (Eve) cannot confirm; the proposer cannot confirm itself twice.
  submitMustFail eve   do exerciseCmd propCid Confirm with member = eve
  submitMustFail venue do exerciseCmd propCid Confirm with member = venue
  -- ONE attestation (the proposer's) is below the 2-of-3 threshold — cannot finalise.
  submitMustFail venue do exerciseCmd propCid FinalizeFixing with publishTo = [venue]

  -- A SECOND member (bank) confirms → two distinct attestors. Now it can finalise.
  propCid2 <- submit bank do exerciseCmd propCid Confirm with member = bank
  fixCid   <- submit venue do exerciseCmd propCid2 FinalizeFixing with publishTo = [venue]

  -- The official fix carries >= threshold attestors, at the attested price.
  Some fix <- queryContractId venue fixCid
  fix.price === 2400.0
  fix.instrumentId === ceth
  assertMsg "official fix must carry at least the threshold of attestors"
    (length fix.attestors >= 2)
  -- The auditor and the published-to venue see it; an outsider does NOT.
  assertMsg "auditor must see the official fix"  . isSome =<< queryContractId auditor fixCid
  assertMsg "outsider must NOT see the fix (governance without leakage)"
    . isNone =<< queryContractId eve fixCid

-- ---------------------------------------------------------------------------
-- TEST 9 — COMMITTEE-ATTESTED CLOSE: an auction BOUND to a NavFixing may only run
-- against the ATTESTED ANCHOR. What the committee fixes is no longer the print.
-- ---------------------------------------------------------------------------
-- THE HONEST PROPERTY, AFTER PRICE DISCOVERY. It used to be true that a bound
-- auction printed the attested number — the close simply took `referencePrice` as
-- the price and checked it against the fix. That is no longer what happens, and
-- asserting it would now be a lie: the print comes out of the BOOK. What the
-- committee's K-of-N fix buys you is that the venue cannot run the auction against
-- an anchor of its own choosing — the anchor that enters the candidate set and
-- breaks final ties is provably the committee's. So this test proves THREE things:
--   1. a bound auction whose book brackets the fix prints AT the fix (the anchor
--      wins the tie, which is the case everyone expects);
--   2. a bound auction whose book crosses AWAY from the fix prints AWAY from it —
--      the orders outrank the committee on price, exactly as they should;
--   3. an auction whose anchor DISAGREES with the fix cannot run at all.
-- ---------------------------------------------------------------------------
testCommitteeAttestedClose : Script ()
testCommitteeAttestedClose = do
  Parties{..} <- setup
  setupInstruments issuer

  -- 2-of-3 committee attests cETH close @ 2,400 and publishes the fix to the venue.
  let members = [venue, bank, agent]
  committeeCid <- submit issuer do
    createCmd OperatorCommittee with
      admin = issuer; members; threshold = 2; auditor; label = "NAV Committee"
  propCid  <- submit venue do
    exerciseCmd committeeCid ProposeFixing with
      proposer = venue; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; price = 2400.0; rationale = "cross VWAP"
  propCid2 <- submit bank do exerciseCmd propCid Confirm with member = bank
  fixCid   <- submit venue do exerciseCmd propCid2 FinalizeFixing with publishTo = [venue]

  -- (1) The venue opens a close BOUND to the committee fix (fixingRef = Some fix),
  -- anchored on the attested 2,400. Bob offers at 2,350, Alice bids 2,500 — the
  -- book brackets the fix, every candidate trades the full 3 flat, so the anchor
  -- wins the final tie-break and the print IS the attested number.
  bobCeth   <- mint issuer ceth bob   3.0
  aliceCash <- mint issuer usdc alice 7500.0   -- 3 @ her 2,500 limit
  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; referencePrice = 2400.0
      participants = [alice, bob]; liquidityProvider = None
      fixingRef = Some fixCid
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (a1, bobSell)  <- submitOrder auctionCid bob   Sell 3.0 2350.0 bobCeth
  (a2, aliceBuy) <- submitOrder a1         alice Buy  3.0 2500.0 aliceCash

  closedCid <- submit venue do exerciseCmd a2 CloseBidding
  batchCid  <- submit venue do
    exerciseCmd closedCid RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]

  -- The close printed at the attested 2,400 and settled the cross.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 2400.0
  Some theFix <- queryContractId venue fixCid
  assertMsg "the print matched the committee's attested anchor"
    (batch.closingPrice == theFix.price)
  aliceCeth <- ownedAmount alice ceth
  bobUsd    <- ownedAmount bob   usdc
  aliceCeth === 3.0
  bobUsd    === 7200.0

  -- (2) THE ORDERS OUTRANK THE COMMITTEE ON PRICE. A second auction, bound to the
  -- SAME 2,400 fix, but this time the whole book sits below it: Bob offers 5 at
  -- 2,300, Alice bids 5 at 2,350. At 2,400 not a single unit would trade. The
  -- uncross therefore prints 2,350 — the nearest price to the anchor at which the
  -- book actually crosses — and the committee's number does NOT override it. This
  -- is the property the old test could not have: the fix is the anchor, not the
  -- print.
  bobCeth3   <- mint issuer ceth bob   5.0
  aliceCash3 <- mint issuer usdc alice 11750.0  -- 5 @ her 2,350 limit
  awayAuction <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; referencePrice = 2400.0
      participants = [alice, bob]; liquidityProvider = None
      fixingRef = Some fixCid
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (b1, awaySell) <- submitOrder awayAuction bob   Sell 5.0 2300.0 bobCeth3
  (b2, awayBuy)  <- submitOrder b1          alice Buy  5.0 2350.0 aliceCash3
  awayClosed <- submit venue do exerciseCmd b2 CloseBidding
  awayBatch  <- submit venue do
    exerciseCmd awayClosed RunClose with buyOrders = [awayBuy]; sellOrders = [awaySell]
  Some batch2 <- queryContractId auditor awayBatch
  batch2.closingPrice === 2350.0
  assertMsg "a bound close prints where the BOOK crosses, not at the attested NAV"
    (batch2.closingPrice /= theFix.price)

  -- (3) TAMPER GUARD: an auction that binds to the SAME fix but publishes a
  -- DIFFERENT anchor (2,450) cannot run its close at all — the attestation anchors
  -- 2,400, so RunClose aborts before a single leg moves. The venue cannot smuggle
  -- its own reference into a governed auction.
  bobCeth2   <- mint issuer ceth bob   1.0
  aliceCash2 <- mint issuer usdc alice 2500.0
  badAuction <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; referencePrice = 2450.0
      participants = [alice, bob]; liquidityProvider = None
      fixingRef = Some fixCid
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (c1, badSell) <- submitOrder badAuction bob   Sell 1.0 2400.0 bobCeth2
  (c2, badBuy)  <- submitOrder c1         alice Buy  1.0 2500.0 aliceCash2
  badClosed <- submit venue do exerciseCmd c2 CloseBidding
  submitMustFail venue do
    exerciseCmd badClosed RunClose with buyOrders = [badBuy]; sellOrders = [badSell]

-- ===========================================================================
-- TESTS 9a–9e — CONTINUOUS ACCRUAL NAV.
-- ===========================================================================
-- The committee attests the INPUTS (base, rate, day count, origin); the ledger
-- computes the value at every instant in between. These five scripts pin down the
-- arithmetic, the precision, and the auction anchor that now depends on it.
-- ---------------------------------------------------------------------------

-- accrualFixture — a `NavFixing` as a plain RECORD VALUE, not a ledger contract.
-- `navAt` and `accruedAmount` are pure and total, so they can be exercised with no
-- ledger at all — the same way `testPriceDiscoveryUnit` exercises the uncross. A
-- fund's value between marks is arithmetic; this is the test that treats it as such.
accrualFixture : Party -> Party -> Decimal -> Decimal -> Text -> Time -> NavFixing
accrualFixture admin auditor base rate dayCount from = NavFixing with
  attestors = [admin]; admin; auditor; threshold = 1
  instrumentId = ceth; cashInstrument = usdc; session = "Close"
  price = base; rationale = "accrual unit fixture"
  ratePerAnnum = rate; dayCount; accrualFrom = from
  publishedTo = []; finalizedAt = from

-- ---------------------------------------------------------------------------
-- TEST 9a — THE ACCRUAL ARITHMETIC, HAND-COMPUTED.
-- ---------------------------------------------------------------------------
-- 3.6%/yr on ACT/360 accrues EXACTLY one basis point of NAV per day, because
-- 0.036 / 360 = 0.0001 with nothing left over. That makes every expected value below
-- checkable in your head, which is the point of choosing it: a test whose expected
-- numbers came out of the implementation proves nothing.
--
-- It also pins the DAY-COUNT CONVENTION as a real economic input rather than a label:
-- the SAME attested 3.6% accrues 0.0100000000 per day on ACT/360 and 0.0098630137 on
-- ACT/365F — a 1.389% difference in the fund's yield, decided entirely by a string a
-- committee signed.
-- ---------------------------------------------------------------------------
testAccrualArithmeticUnit : Script ()
testAccrualArithmeticUnit = do
  Parties{..} <- setup
  t0 <- getTime
  let f360 = accrualFixture issuer auditor 100.0 0.036 "ACT/360"  t0
      f365 = accrualFixture issuer auditor 100.0 0.036 "ACT/365F" t0

  -- ONE BASIS POINT PER DAY, exactly, and it scales linearly (simple interest — the
  -- money-market convention, see the Governance header).
  navAt f360 (addRelTime t0 (days  1)) === 100.01
  navAt f360 (addRelTime t0 (days 10)) === 100.10
  navAt f360 (addRelTime t0 (hours 12)) === 100.005          -- half a day, half a bp
  navAt f360 (addRelTime t0 (hours  1)) === 100.0004166667   -- 0.01 / 24, rounded at 10dp

  -- THE CONVENTION IS NOT COSMETIC. Same base, same attested rate, same elapsed day.
  navAt f365 (addRelTime t0 (days 1)) === 100.0098630137
  assertMsg "ACT/360 must accrue MORE than ACT/365F on the same quoted rate"
    (navAt f360 (addRelTime t0 (days 1)) > navAt f365 (addRelTime t0 (days 1)))

  -- A ZERO-RATE FIXING IS THE OLD SNAPSHOT, UNCHANGED — this is what the untouched
  -- `ProposeFixing` path produces, so nothing that existed before this feature moves.
  let snap = accrualFixture issuer auditor 100.0 0.0 "NONE" t0
  navAt snap (addRelTime t0 (days 3650)) === 100.0

-- ---------------------------------------------------------------------------
-- TEST 9b — ZERO AT THE STRIKE, MONOTONE AFTER IT, AND LIVE EVERY SECOND.
-- ---------------------------------------------------------------------------
-- The claim the product rests on is that the fund has a correct value at 03:41 on a
-- Sunday, so per-SECOND accrual has to be more than a slogan: it has to be
-- representable. On a NAV of 100 at 3.6% one second is 1.157e-7 — over a thousand
-- times the ledger's 1e-10 resolution, so the clock genuinely moves the number.
-- ---------------------------------------------------------------------------
testAccrualMonotoneAndZeroAtStrike : Script ()
testAccrualMonotoneAndZeroAtStrike = do
  Parties{..} <- setup
  t0 <- getTime
  let f = accrualFixture issuer auditor 100.0 0.036 "ACT/360" t0

  -- AT the strike instant, nothing has accrued: the attested base IS the value.
  navAt f t0 === 100.0
  navAtChecked f t0 === Some 100.0

  let v1s = navAt f (addRelTime t0 (seconds 1))
      v1h = navAt f (addRelTime t0 (hours 1))
      v1d = navAt f (addRelTime t0 (days 1))

  -- ONE SECOND ALREADY MOVES THE NUMBER — not a rounding artefact, a real 1.157e-7.
  v1s === 100.0000001157
  assertMsg "a single second must accrue a representable, non-zero amount" (v1s > 100.0)
  -- MONOTONE in time, strictly, at every scale that matters.
  assertMsg "accrual must be monotone in elapsed time" (v1s < v1h && v1h < v1d)
  v1d === 100.01

-- ---------------------------------------------------------------------------
-- TEST 9c — ONE STEP vs MANY STEPS, AND THE PRECISION TOLD HONESTLY.
-- ---------------------------------------------------------------------------
-- Accrual is always computed FROM THE ATTESTED BASE over the WHOLE elapsed interval,
-- never accumulated from a previous value, so there is no path dependence to test —
-- only the rounding of each independent evaluation. Each one is within half a unit in
-- the last place (5e-11), so N of them summed can differ from the single-step figure
-- by at most N x 5e-11 AND BY NOTHING ELSE. That bound is DERIVED, not tuned, and
-- this test measures the real difference against it rather than asserting equality
-- that does not hold.
--
-- IT ALSO SHOWS WHY THE IMPLEMENTATION ORDERS ITS OPERATIONS THE WAY IT DOES: the
-- final block accumulates a $1.00 money-market share second by second — the obvious
-- way to write this — and lands 1.09% away from the right answer. That is the failure
-- mode the Governance header warns about, demonstrated rather than asserted.
-- ---------------------------------------------------------------------------
testAccrualStepsAgree : Script ()
testAccrualStepsAgree = do
  let dayMicros    = 86400 * 1000000
      sixHrMicros  = 21600 * 1000000
      oneHrMicros  =  3600 * 1000000
      oneDay   = accruedAmount 100.0 0.036 "ACT/360" dayMicros
      sixHours = accruedAmount 100.0 0.036 "ACT/360" sixHrMicros
      oneHour  = accruedAmount 100.0 0.036 "ACT/360" oneHrMicros

  oneDay   === 0.01      -- one basis point of a NAV of 100
  sixHours === 0.0025

  -- WHEN THE SUB-PERIOD DIVIDES EXACTLY there is no rounding to accumulate and the
  -- decomposition is EXACT — not "within tolerance", identical.
  4.0 * sixHours === oneDay

  -- WHEN IT DOES NOT, each of the 24 hourly figures carries its own half-ulp.
  let steps      = 24.0
      twentyFour = steps * oneHour
      -- THE DERIVED BOUND: N independent evaluations x HALF a unit in the last place.
      -- Written as `N x ulp / 2` because half a ulp (5e-11) is not itself a
      -- representable `Decimal` — which is worth noticing, since it is precisely the
      -- quantity the rounding of every one of these evaluations is bounded by.
      stepBound  = steps * 0.0000000001 / 2.0    -- = 1.2e-9
  assertMsg "the step decomposition must genuinely differ — this measures rounding, \
            \not a vacuous equality"
    (twentyFour /= oneDay)
  assertMsg "24 hourly accruals must match the one-step day within 24 half-ulps"
    (abs (twentyFour - oneDay) <= stepBound)
  -- Pin the actual observed drift so a regression in the operation order is caught,
  -- not merely bounded: 8e-10 on a NAV of 100, i.e. 8e-12 relative.
  abs (twentyFour - oneDay) === 0.0000000008

  -- ------------------------------------------------------------------------
  -- THE HONEST EDGE CASE, STATED PLAINLY RATHER THAN HIDDEN. On a $1.00
  -- money-market share at 4%/yr, ONE SECOND of accrual is 1.286e-9 — which at 10dp
  -- quantises to 0.0000000013, only about 13 units in the last place. Per-second
  -- accrual IS representable at that scale, but it is COARSE: the quantisation is
  -- ~1% of the increment.
  -- THE MITIGATION IS THE DESIGN ITSELF. Because a day's accrual is computed in ONE
  -- division over the whole interval, that coarseness never compounds. Accumulate it
  -- second by second instead and the error is 1.09% of the fund's daily yield —
  -- which is exactly what the block below measures.
  -- ------------------------------------------------------------------------
  let secondOnADollar = accruedAmount 1.0 0.04 "ACT/360" 1000000
      naiveDollarDay  = 86400.0 * secondOnADollar          -- accumulated per second
      trueDollarDay   = accruedAmount 1.0 0.04 "ACT/360" dayMicros
  secondOnADollar === 0.0000000013
  trueDollarDay   === 0.0001111111
  assertMsg "per-second accumulation on a $1 share must be materially WRONG — this is \
            \why accrual is always computed from the base over the whole interval"
    (abs (naiveDollarDay - trueDollarDay) > 0.000001)

-- ---------------------------------------------------------------------------
-- TEST 9d — THE AUCTION ANCHOR IS THE NAV ACCRUED TO THE CLOSE.
-- ---------------------------------------------------------------------------
-- `RunClose` used to demand the anchor EQUAL the struck price. Accrual makes that
-- wrong, not strict: ten days after a 2,400 mark at 3.6% ACT/360 the fund is worth
-- 2,402.40, and a venue anchoring on 2,400 is anchoring on a number that stopped
-- being true 240 hours ago.
--   * an auction anchored on the ACCRUED NAV (2,402.40) runs and prints there;
--   * an auction anchored on the STALE STRUCK price (2,400.00) cannot run at all.
-- The boundary of the 1bp staleness budget is pinned on the pure predicate: one day
-- of drift is inside it (that is what "1bp = one day at 3.6%" means), two days is
-- not, and an anchor AHEAD of the accrual is rejected outright however small.
-- ---------------------------------------------------------------------------
testAccruedAnchorBindsTheClose : Script ()
testAccruedAnchorBindsTheClose = do
  Parties{..} <- setup
  setupInstruments issuer

  -- A 2-of-3 committee attests the INPUTS: base 2,400, 3.6%/yr, ACT/360, from now.
  t0 <- getTime
  let members = [venue, bank, agent]
  committeeCid <- submit issuer do
    createCmd OperatorCommittee with
      admin = issuer; members; threshold = 2; auditor; label = "Treasury NAV Committee"
  propCid <- submit venue do
    exerciseCmd committeeCid ProposeAccruingFixing with
      proposer = venue; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; price = 2400.0
      rationale = "tokenised T-bill fund: 3.6% money-market yield, ACT/360"
      ratePerAnnum = 0.036; dayCount = "ACT/360"; accrualFrom = t0
  propCid2 <- submit bank  do exerciseCmd propCid Confirm with member = bank
  fixCid   <- submit venue do exerciseCmd propCid2 FinalizeFixing with publishTo = [venue]

  -- What K-of-N actually signed is the RECIPE, not just the number.
  Some fix <- queryContractId venue fixCid
  fix.price        === 2400.0
  fix.ratePerAnnum === 0.036
  fix.dayCount     === "ACT/360"
  fix.accrualFrom  === t0

  -- THE STALENESS BUDGET, on the pure predicate, so the width is pinned exactly.
  -- 2,400 at 3.6% accrues 0.24/day. One day behind is inside 1bp; two days is not.
  assertMsg "one day of anchor staleness is inside the 1bp budget at 3.6%"
    (anchorConsistentWithNav (navAt fix (addRelTime t0 (days 1))) 2400.0)
  assertMsg "two days of anchor staleness must be REJECTED"
    (not (anchorConsistentWithNav (navAt fix (addRelTime t0 (days 2))) 2400.0))
  assertMsg "an anchor AHEAD of the accrued NAV is rejected however small the excess"
    (not (anchorConsistentWithNav 2400.0 2400.01))

  -- TEN DAYS PASS. The committee has attested nothing further; the ledger has been
  -- computing the value the whole time.
  passTime (days 10)
  nowAtClose <- getTime
  navAt fix nowAtClose === 2402.40      -- 2,400 + 10 x 0.24, derived, not attested

  -- (1) A CLOSE ANCHORED ON THE ACCRUED NAV RUNS. Bob offers 3 at 2,350, Alice bids
  -- 3 at 2,500: every candidate trades the full 3 flat, so the anchor takes the final
  -- tie-break and the print IS the accrued NAV.
  bobCeth   <- mint issuer ceth bob   3.0
  aliceCash <- mint issuer usdc alice 7500.0
  goodAuction <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; referencePrice = 2402.40      -- the ACCRUED NAV
      participants = [alice, bob]; liquidityProvider = None
      fixingRef = Some fixCid
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (g1, bobSell)  <- submitOrder goodAuction bob   Sell 3.0 2350.0 bobCeth
  (g2, aliceBuy) <- submitOrder g1          alice Buy  3.0 2500.0 aliceCash
  goodClosed <- submit venue do exerciseCmd g2 CloseBidding
  goodBatch  <- submit venue do
    exerciseCmd goodClosed RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]
  Some batch <- queryContractId auditor goodBatch
  batch.closingPrice === 2402.40
  assertMsg "the print must be the ACCRUED NAV, not the struck base"
    (batch.closingPrice /= fix.price)

  -- (2) THE SAME BOOK ANCHORED ON THE STALE STRUCK PRICE CANNOT CLOSE. Nothing is
  -- wrong with the fixing, the orders, or the venue — only with the anchor's age.
  bobCeth2   <- mint issuer ceth bob   3.0
  aliceCash2 <- mint issuer usdc alice 7500.0
  staleAuction <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; referencePrice = 2400.0      -- the STRUCK price, 10 days old
      participants = [alice, bob]; liquidityProvider = None
      fixingRef = Some fixCid
      submittedCount = 0; cancelledCount = 0; isOpen = True
  (s1, staleSell) <- submitOrder staleAuction bob   Sell 3.0 2350.0 bobCeth2
  (s2, staleBuy)  <- submitOrder s1           alice Buy  3.0 2500.0 aliceCash2
  staleClosed <- submit venue do exerciseCmd s2 CloseBidding
  submitMustFail venue do
    exerciseCmd staleClosed RunClose with buyOrders = [staleBuy]; sellOrders = [staleSell]

-- ---------------------------------------------------------------------------
-- TEST 9e — TIME RUNNING BACKWARDS IS HANDLED, NOT SILENTLY WRONG.
-- ---------------------------------------------------------------------------
-- A query about an instant BEFORE a fixing applies from is legitimate (a backfill, a
-- replay, a report window that opens early). The wrong answers are a negative accrual
-- — silently marking the fund BELOW a value the committee attested — and an abort
-- that makes the function partial. `navAt` clamps to the attested base, and
-- `navAtChecked` exists so a caller that must distinguish "before the strike" from
-- "at the strike" can.
--
-- It also pins the other silent-failure guard: an UNSUPPORTED day-count convention is
-- rejected at proposal time rather than defaulted, because defaulting a typo to
-- ACT/360 would mis-accrue a sterling fund by 1.389% of its yield under a signed
-- attestation saying otherwise.
-- ---------------------------------------------------------------------------
testAccrualBackwardsTimeIsSafe : Script ()
testAccrualBackwardsTimeIsSafe = do
  Parties{..} <- setup
  setupInstruments issuer
  t0 <- getTime
  let f = accrualFixture issuer auditor 100.0 0.036 "ACT/360" t0

  -- BEFORE the strike: the attested base, never less than it.
  navAt f (addRelTime t0 (days (-1)))    === 100.0
  navAt f (addRelTime t0 (seconds (-1))) === 100.0
  assertMsg "a pre-strike query must never report BELOW the attested base"
    (navAt f (addRelTime t0 (days (-3650))) >= 100.0)

  -- ...and the caller that needs to KNOW gets told, rather than getting a number that
  -- is indistinguishable from an at-strike answer.
  navAtChecked f (addRelTime t0 (days (-1)))    === None
  navAtChecked f (addRelTime t0 (seconds (-1))) === None
  navAtChecked f t0                             === Some 100.0

  -- The raw accrual function clamps at the same place, so nothing downstream of it
  -- can be handed a negative amount.
  accruedAmount 100.0 0.036 "ACT/360" (-86400000000) === 0.0
  accruedAmount 100.0 0.036 "ACT/360" 0              === 0.0

  -- AN UNSUPPORTED CONVENTION IS REJECTED, NOT DEFAULTED — at the ledger, at the
  -- moment a member tries to attest it.
  let members = [venue, bank, agent]
  committeeCid <- submit issuer do
    createCmd OperatorCommittee with
      admin = issuer; members; threshold = 2; auditor; label = "NAV Committee"
  submitMustFail venue do
    exerciseCmd committeeCid ProposeAccruingFixing with
      proposer = venue; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; price = 2400.0; rationale = "bond convention on a bill fund"
      ratePerAnnum = 0.036; dayCount = "30/360"; accrualFrom = t0
  -- A rate at or below -100%/yr is a typo, not a money market.
  submitMustFail venue do
    exerciseCmd committeeCid ProposeAccruingFixing with
      proposer = venue; instrumentId = ceth; cashInstrument = usdc
      session = "Close"; price = 2400.0; rationale = "typo"
      ratePerAnnum = -1.5; dayCount = "ACT/360"; accrualFrom = t0
  -- And an unrecognised convention accrues NOTHING if one ever reached the pure
  -- function directly, rather than guessing a year length.
  accruedAmount 100.0 0.036 "30/360" 86400000000 === 0.0

-- ---------------------------------------------------------------------------
-- TEST 10 — IN-KIND CREATION + REDEMPTION of an ETF basket (LX1 = 0.10 cETH +
-- 0.01 CBTC per share). Creation atomically pulls the underlyings into custody and
-- MINTS shares; redemption burns shares and returns the underlyings — both DvP-atomic.
-- ---------------------------------------------------------------------------
testCreateThenRedeem : Script ()
testCreateThenRedeem = do
  Parties{..} <- setup
  setupInstruments issuer

  -- The fund administrator/custodian is `bank`; the AP is Alice. The underlying
  -- instruments are still issued by `issuer` (onRails-style), kept distinct.
  let comps = [Component ceth 0.10, Component cbtc 0.01]
  basketCid <- submit bank do
    createCmd BasketDefinition with
      administrator = bank; auditor; basketId = "LX1"
      description = "Lucilla Crypto Index (cETH + CBTC)"; cashInstrument = usdc
      components = comps; participants = [alice, bob]

  -- Alice holds the exact creation basket for 10 shares: 1.0 cETH + 0.1 CBTC.
  aliceCeth <- mint issuer ceth alice 1.0
  aliceCbtc <- mint issuer cbtc alice 0.1

  -- CREATE 10 shares: request → approve → process (atomic).
  orderCid <- submit alice do
    exerciseCmd basketCid RequestCreation with
      ap = alice; shares = 10.0; componentHoldingCids = [aliceCeth, aliceCbtc]
  agreeCid <- submit bank do exerciseCmd orderCid ApproveCreation
  cRes     <- submit bank do exerciseCmd agreeCid ProcessCreation

  -- Alice received 10 LX1 shares; her underlyings moved into the administrator's custody.
  Some sh <- queryContractId alice cRes.mintedShares
  sh.owner        === alice
  sh.instrumentId === "LX1"
  sh.amount       === 10.0
  aliceCethBal <- ownedAmount alice ceth
  aliceCbtcBal <- ownedAmount alice cbtc
  aliceCethBal === 0.0
  aliceCbtcBal === 0.0
  bankCeth0 <- ownedAmount bank ceth
  bankCbtc0 <- ownedAmount bank cbtc
  bankCeth0 === 1.0
  bankCbtc0 === 0.1
  -- The auditor sees the creation receipt; an outsider sees nothing.
  assertMsg "auditor must see the creation receipt" . isSome =<< queryContractId auditor cRes.receipt
  assertMsg "outsider must NOT see the minted shares" . isNone =<< queryContractId eve cRes.mintedShares

  -- REDEEM 4 shares: Alice returns 4 LX1 and gets back 0.4 cETH + 0.04 CBTC. The
  -- administrator supplies the custody holdings it will deliver back.
  bankCethCid <- head . map fst
    . filter (\(_, h) -> h.owner == bank && h.instrumentId == ceth) <$> query @Holding bank
  bankCbtcCid <- head . map fst
    . filter (\(_, h) -> h.owner == bank && h.instrumentId == cbtc) <$> query @Holding bank
  redOrder <- submit alice do
    exerciseCmd basketCid RequestRedemption with
      ap = alice; shares = 4.0; basketHoldingCid = cRes.mintedShares
  redAgree <- submit bank do
    exerciseCmd redOrder ApproveRedemption with custodyHoldingCids = [bankCethCid, bankCbtcCid]
  _redRes  <- submit bank do exerciseCmd redAgree ProcessRedemption

  -- Alice now holds 6 LX1 and got 0.4 cETH + 0.04 CBTC back; custody holds the rest.
  aliceLx    <- ownedAmount alice "LX1"
  aliceCeth2 <- ownedAmount alice ceth
  aliceCbtc2 <- ownedAmount alice cbtc
  aliceLx    === 6.0
  aliceCeth2 === 0.4
  aliceCbtc2 === 0.04
  bankCeth1  <- ownedAmount bank ceth
  bankCbtc1  <- ownedAmount bank cbtc
  bankCeth1  === 0.6
  bankCbtc1  === 0.06

-- ---------------------------------------------------------------------------
-- TEST 11 — CREATION ATOMIC ROLLBACK: an AP short on ONE component cannot create.
-- The request validates every leg up front, so nothing moves and nothing is minted.
-- ---------------------------------------------------------------------------
testCreationAtomicRollback : Script ()
testCreationAtomicRollback = do
  Parties{..} <- setup
  setupInstruments issuer

  let comps = [Component ceth 0.10, Component cbtc 0.01]
  basketCid <- submit bank do
    createCmd BasketDefinition with
      administrator = bank; auditor; basketId = "LX1"
      description = "idx"; cashInstrument = usdc
      components = comps; participants = [alice]

  -- Enough cETH (needs 1.0) but SHORT CBTC (needs 0.1, has 0.05) for 10 shares.
  aliceCeth <- mint issuer ceth alice 1.0
  aliceCbtc <- mint issuer cbtc alice 0.05
  submitMustFail alice do
    exerciseCmd basketCid RequestCreation with
      ap = alice; shares = 10.0; componentHoldingCids = [aliceCeth, aliceCbtc]

  -- Alice keeps everything; no shares exist.
  aliceCethBal <- ownedAmount alice ceth
  aliceCbtcBal <- ownedAmount alice cbtc
  aliceLx      <- ownedAmount alice "LX1"
  aliceCethBal === 1.0
  aliceCbtcBal === 0.05
  aliceLx      === 0.0

-- ---------------------------------------------------------------------------
-- TEST 12 — NAV per share = Σ (unitsPerShare × price). With cETH @ 2,400 and CBTC
-- @ 65,000: 0.10×2,400 + 0.01×65,000 = 240 + 650 = 890. A missing mark = no NAV.
-- ---------------------------------------------------------------------------
testNavPerShare : Script ()
testNavPerShare = do
  let comps = [Component ceth 0.10, Component cbtc 0.01]
  let priceOf t
        | t == ceth = Some 2400.0
        | t == cbtc = Some 65000.0
        | otherwise = None
  navPerShare comps priceOf === Some 890.0
  navPerShare comps (const None) === None

-- ---------------------------------------------------------------------------
-- TEST 13 — THE ALLOCATION RULE AS PURE ARITHMETIC.
-- ---------------------------------------------------------------------------
-- The rule every real closing auction shares, pinned down with no ledger in the
-- way: ORDERS PRICED STRICTLY THROUGH THE PRINT FILL IN FULL, and only the marginal
-- (at-the-print) level is ever rationed.
--   Xetra T7 §11.1.1: "price/time priority is valid so that the maximum of ONE
--     order, which is either limited to the auction price or is unlimited, can be
--     partially executed."
--   Euronext §3.1: buys above / sells below the traded price "are filled in their
--     entirety (price priority)"; only at-price orders are rationed.
--   Nasdaq Rule 4754(b)(3): class → PRICE → display → time.
--   NYSE Rule 7.35B(h)(1): better-priced orders "are GUARANTEED to participate."
-- What CrossDesk used to do — pro-rate the ENTIRE eligible side — is the one thing
-- none of them do, and it is why this test exists.
-- ---------------------------------------------------------------------------
testAllocationUnit : Script ()
testAllocationUnit = do
  -- (1) THROUGH THE PRINT FILLS IN FULL; THE MARGINAL LEVEL IS RATIONED.
  -- Fifteen units of demand to hand out. The 110 bid is priced through a 100 print
  -- and takes all 10 of what it asked for. The two 100 bids are the marginal level:
  -- 5 units left over 20 of interest, so 2.5 each. Under the old rule all three
  -- would have been cut to 5 and the 110 bid would have gained nothing for bidding
  -- up — which is exactly the equilibrium that makes oversizing rational.
  allocateSide Buy 15.0
    [("thru", Some 110.0, 10.0), ("at1", Some 100.0, 10.0), ("at2", Some 100.0, 10.0)]
    === [("thru", 10.0), ("at1", 2.5), ("at2", 2.5)]

  -- (2) THREE LEVELS, AND THE WORST-PRICED ONE GETS NOTHING. Ten units: the 120 bid
  -- clears in full, the 110 bid takes the remaining 4, and the 100 bid — eligible,
  -- but behind two better prices — is allocated ZERO. Eligibility is not precedence.
  -- Note the input is deliberately out of order: priority comes from the PRICE.
  allocateSide Buy 10.0
    [("lo", Some 100.0, 10.0), ("hi", Some 120.0, 6.0), ("mid", Some 110.0, 8.0)]
    === [("hi", 6.0), ("mid", 4.0), ("lo", 0.0)]

  -- (3) THE SELL SIDE IS THE MIRROR IMAGE: a LOWER limit is the more aggressive
  -- offer, so it is the one that fills first. (This is the book in TEST 3f.)
  allocateSide Sell 15.0 [("high", Some 256.0, 10.0), ("low", Some 250.0, 10.0)]
    === [("low", 10.0), ("high", 5.0)]

  -- (4) THE LIGHT SIDE IS NOT A SPECIAL CASE. When the crossed volume equals the
  -- side's own total, every level fills in full and the same function is a no-op —
  -- which is why the close no longer branches on "which side is heavy".
  allocateSide Buy 20.0 [("a", Some 260.0, 12.0), ("b", Some 255.0, 8.0)]
    === [("a", 12.0), ("b", 8.0)]

  -- (5) THE ALLOCATION SUMS EXACTLY TO THE CROSSED VOLUME. This is the audit's
  -- worked example: three equal bids of 100 against 100 units of supply. A third of
  -- 100 is not representable, the three raw shares sum to 99.9999999999, and the
  -- pool holds 100. The residual (one ledger unit, 1e-10) is carried by the largest
  -- order at the level — all three tie on size, so it goes to the first in the book.
  -- The point is the LAST line: the fills sum to the crossed volume on the nose, so
  -- nobody has to silently absorb a pool remainder and no receipt can misstate it.
  let thirds = allocateSide Buy 100.0
        [("a", Some 260.0, 100.0), ("b", Some 260.0, 100.0), ("c", Some 260.0, 100.0)]
  thirds === [("a", 33.3333333334), ("b", 33.3333333333), ("c", 33.3333333333)]
  sum (map snd thirds) === 100.0

  -- (6) THE RESIDUAL GOES TO THE LARGEST ORDER, NOT TO WHOEVER IS LAST. Here the
  -- raw shares round UP and sum to one unit MORE than the crossed volume, so the
  -- residual is negative — and it is still the big order that carries it, even
  -- though it is listed FIRST. That is the whole difference from the old behaviour,
  -- where array position decided who absorbed the rounding.
  let sixths = allocateSide Buy 1.0
        [("big", Some 100.0, 4.0), ("s1", Some 100.0, 1.0), ("s2", Some 100.0, 1.0)]
  sixths === [("big", 0.6666666666), ("s1", 0.1666666667), ("s2", 0.1666666667)]
  sum (map snd sixths) === 1.0

  -- (7) DUST ROUNDS TO ZERO AND NOTHING EXPLODES. A 1e-10 order alongside a million
  -- gets a share of about 1e-16, which is below the ledger's smallest unit, so its
  -- allocation is exactly 0.0 — and the side still sums to the crossed volume.
  -- `RunClose` filters that order out before pledging instead of aborting on it.
  let dusty = allocateSide Sell 1.0
        [("whale", Some 250.0, 1000000.0), ("dust", Some 250.0, 0.0000000001)]
  dusty === [("whale", 1.0), ("dust", 0.0)]
  sum (map snd dusty) === 1.0

  -- (8) THE COLLAR, as pure arithmetic. Nasdaq: "the greater of $0.50 or 10%."
  -- At a 255 anchor the percentage dominates; at a 2.00 anchor 10% would be 0.20 and
  -- the ABSOLUTE FLOOR binds instead — which is the reason every venue with a
  -- percentage band publishes one (Nasdaq $0.50, Euronext EUR 0.02, NYSE $0.15).
  collarBand 255.0 === 25.5
  collarBand 2.0   === 0.5
  collarBand 0.01  === 0.5
  assertMsg "the top edge of the band must be printable"     (withinCollar 255.0 280.5)
  assertMsg "a hair above the band must not print"      (not (withinCollar 255.0 280.51))
  assertMsg "the bottom edge of the band must be printable"  (withinCollar 255.0 229.5)
  assertMsg "a hair below the band must not print"      (not (withinCollar 255.0 229.49))

-- ---------------------------------------------------------------------------
-- TEST 14 — MIXED SURPLUS: narrow to the boundary pair BEFORE the anchor votes.
-- ---------------------------------------------------------------------------
-- Xetra T7 §11.1.1 step 4, case (a): when the surviving limits carry a BID surplus
-- on one part and an ASK surplus on another, the algorithm first narrows to "the
-- lowest limit with an ask surplus or the highest limit with a bid surplus", and
-- only then clamps the reference price into what is left.
--
-- WHY IT IS LOAD-BEARING AND NOT PEDANTRY. Skip that step and a far-away anchor can
-- drag the print PAST the boundary onto a survivor at which a better-priced order
-- on the heavy side cannot be filled in full — the exact outcome NYSE Rule
-- 7.35B(g)(1) forbids a DMM from choosing ("the DMM must select an Auction Price at
-- which all better-priced orders on the Side of the Imbalance can be satisfied").
-- With the narrowing in place, "priced through the print fills in full" is always
-- feasible, which is what makes TEST 13's allocation rule sound rather than lucky.
-- ---------------------------------------------------------------------------
testMixedSurplusTieBreak : Script ()
testMixedSurplusTieBreak = do
  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      priceOf  = fmap (\c -> c.price)
      -- The pathological book: supply and demand interleaved so that FOUR different
      -- prices trade the same 10 units and strand the same 10 — two bid-heavy, two
      -- ask-heavy. Volume cannot separate them and imbalance cannot separate them.
      book = [sell 10.0 90.0, buy 10.0 100.0, sell 10.0 150.0, buy 10.0 200.0]

  (crossAt book  90.0).executedQty === 10.0
  (crossAt book 100.0).executedQty === 10.0
  (crossAt book 150.0).executedQty === 10.0
  (crossAt book 200.0).executedQty === 10.0
  (crossAt book  90.0).imbalance ===  10.0   -- bid surplus
  (crossAt book 100.0).imbalance ===  10.0   -- bid surplus
  (crossAt book 150.0).imbalance === -10.0   -- ask surplus
  (crossAt book 200.0).imbalance === -10.0   -- ask surplus

  -- ANCHOR BELOW THE INTERVAL. The four survivors narrow to the boundary pair —
  -- highest bid-surplus limit (100) and lowest ask-surplus limit (150) — and the
  -- anchor is clamped UP to 100. Without the narrowing the anchor would have pulled
  -- the print all the way down to 90.
  priceOf (discoverPrice 90.0 book) === Some 100.0

  -- ANCHOR ABOVE THE INTERVAL: clamped DOWN to the other boundary, 150.
  priceOf (discoverPrice 300.0 book) === Some 150.0

  -- ANCHOR STRICTLY INSIDE THE INTERVAL: the print IS the anchor. Xetra states this
  -- as "reference strictly between them → auction price = the reference price
  -- itself"; here it falls out for free, because the anchor is in the candidate set
  -- and inside that interval it scores the same volume with ZERO imbalance, so it
  -- wins outright one stage earlier.
  priceOf (discoverPrice 120.0 book) === Some 120.0

  -- THE PAYOFF, MADE CONCRETE. At the old answer (90) the bids priced THROUGH the
  -- print total 20 units against 10 of crossing volume — "better-priced orders fill
  -- in full" is not even arithmetically possible there. At the narrowed print of 100
  -- exactly one bid is through the print, and it takes the whole 10; the bid AT the
  -- print gets nothing, which is correct and is why zero fills must not abort.
  let thru p o = case o.limitPrice of None -> False; Some l -> l > p
      thruAt90  = sum [o.quantity | o <- book, o.side == Buy, thru  90.0 o]
      thruAt100 = sum [o.quantity | o <- book, o.side == Buy, thru 100.0 o]
  thruAt90  === 20.0
  thruAt100 === 10.0
  allocateSide Buy 10.0 [("bid200", Some 200.0, 10.0), ("bid100", Some 100.0, 10.0)]
    === [("bid200", 10.0), ("bid100", 0.0)]

-- ---------------------------------------------------------------------------
-- TEST 15 — ONE DUST ORDER MUST NOT TAKE DOWN THE CLOSE.
-- ---------------------------------------------------------------------------
-- THE LIVENESS BUG, AND WHY IT WAS SERIOUS ON THIS VENUE SPECIFICALLY. The close is
-- ONE atomic Daml transaction — that all-or-nothing finality is the product. So an
-- assertion that trips on ONE order takes down the ENTIRE auction, and
-- `PledgeToVenue` asserts `fillQty > 0.0`. A heavy-side order small enough that its
-- ration rounds below the ledger's smallest unit (1e-10) gets a fill of exactly
-- 0.0 — so a single dust order was a denial of service on the print. Anyone could
-- have sent one.
--
-- Book (AAPL / USDC, anchor 255):
--   SELL Bob   1,000,000 @ 250      BUY Alice 1 @ 260  (reserves 260)
--   SELL Carol 0.0000000001 @ 250   ← the dust
-- Every candidate trades 1 unit and every one is sell-heavy by the same amount, so
-- market pressure prints at the bottom: 250. Carol's ration is ~1e-16 → 0.0.
-- ---------------------------------------------------------------------------
testDustDoesNotAbortTheClose : Script ()
testDustDoesNotAbortTheClose = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  bobAsset   <- mint issuer aapl bob   1000000.0
  carolAsset <- mint issuer aapl carol 0.0000000001   -- one ledger unit of AAPL
  aliceCash  <- mint issuer usdc alice 260.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)   <- submitOrder auctionCid bob   Sell 1000000.0     250.0 bobAsset
  (a2, carolSell) <- submitOrder a1         carol Sell 0.0000000001 250.0 carolAsset
  (a3, aliceBuy)  <- submitOrder a2         alice Buy  1.0           260.0 aliceCash

  sealed <- submit venue do exerciseCmd a3 CloseBidding
  -- THE ASSERTION THAT IS THE WHOLE TEST: this used to abort. The close prints.
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, carolSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 250.0
  -- TWO fill records, not three: Alice's buy and Bob's sell. Carol traded nothing,
  -- so she gets no receipt for a trade that did not happen.
  length batch.fills === 2
  assertMsg "the dust order must not appear in the batch"
    (null (filter (\f -> f.seller == carol) batch.fills))

  -- THE DUST TRADER IS WHOLE. Her order is cleared off the book exactly like an
  -- order that sat away from the print — the archive touches the ORDER, never the
  -- balance — so she still holds every unit she committed and owes nothing.
  assertMsg "a zero-fill order is cancelled on close, not left resting" . isNone
    =<< queryContractId venue carolSell
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 0.0000000001
  carolUsd  === 0.0

  -- Everyone else settles normally: Bob sold 1 of his million at 250, Alice bought
  -- 1 and got her 10 of change back off the 260 she reserved at her limit.
  bobAapl   <- ownedAmount bob   aapl
  bobUsd    <- ownedAmount bob   usdc
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bobAapl   === 999999.0
  bobUsd    === 250.0
  aliceAapl === 1.0
  aliceUsd  === 10.0

-- ---------------------------------------------------------------------------
-- TEST 16 — WHAT WAS DELIVERED IS WHAT THE RECEIPT SAYS.
-- ---------------------------------------------------------------------------
-- THE DEFECT THIS PINS DOWN. `distribute` used to hand the ENTIRE remaining pool to
-- whoever happened to be LAST in the list, ignoring their computed amount — while
-- their `SettlementReceipt` was written from the COMPUTED number. Pro-rata fills do
-- not sum exactly in a fixed-precision Decimal, so the last recipient silently
-- absorbed the residual and their confirm then misstated what they got. On a money
-- path an exchange confirm that disagrees with the ledger is not a rounding
-- nuisance; it is a broken confirm, and who benefits was decided by array position.
--
-- The audit's own worked example, run for real: three bids of 100 against one offer
-- of 100 at a 260 print. 100/3 is not representable — the raw shares are
-- 33.3333333333 and sum to 99.9999999999 against a pool of 100.
-- ---------------------------------------------------------------------------
testFillsMatchReceipts : Script ()
testFillsMatchReceipts = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  -- Each buyer reserves at its own limit: 100 × 260 = 26,000.
  aliceCash <- mint issuer usdc alice 26000.0
  carolCash <- mint issuer usdc carol 26000.0
  daveCash  <- mint issuer usdc dave  26000.0
  bobAsset  <- mint issuer aapl bob   100.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder auctionCid bob   Sell 100.0 260.0 bobAsset
  (a2, aliceBuy) <- submitOrder a1         alice Buy  100.0 260.0 aliceCash
  (a3, carolBuy) <- submitOrder a2         carol Buy  100.0 260.0 carolCash
  (a4, daveBuy)  <- submitOrder a3         dave  Buy  100.0 260.0 daveCash

  sealed   <- submit venue do exerciseCmd a4 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, carolBuy, daveBuy]
      sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 260.0
  length batch.fills === 4

  -- Pull the venue-signed confirm for each participant.
  Some aliceR <- queryContractId auditor (head [f.receipt | f <- batch.fills, f.buyer  == alice])
  Some carolR <- queryContractId auditor (head [f.receipt | f <- batch.fills, f.buyer  == carol])
  Some daveR  <- queryContractId auditor (head [f.receipt | f <- batch.fills, f.buyer  == dave ])
  Some bobR   <- queryContractId auditor (head [f.receipt | f <- batch.fills, f.seller == bob  ])

  -- THE ASSERTION THAT MATTERS: the ledger balance each buyer actually holds IS the
  -- number on their confirm. Dave is LAST in the list the venue supplied — the slot
  -- that used to silently receive the whole pool remainder.
  aliceAapl <- ownedAmount alice aapl
  carolAapl <- ownedAmount carol aapl
  daveAapl  <- ownedAmount dave  aapl
  aliceAapl === aliceR.assetAmount
  carolAapl === carolR.assetAmount
  daveAapl  === daveR.assetAmount

  -- THE RESIDUAL RULE, STATED AND DETERMINISTIC: the marginal level is rationed
  -- pro-rata by size and the one-unit (1e-10) rounding residual is carried by the
  -- LARGEST order at that level — here all three tie on size, so it goes to the
  -- first in the book the close was handed. Alice therefore holds one extra unit,
  -- her receipt SAYS one extra unit, and the three fills sum to exactly the 100 the
  -- uncross crossed.
  aliceR.assetAmount === 33.3333333334
  carolR.assetAmount === 33.3333333333
  daveR.assetAmount  === 33.3333333333
  (aliceR.assetAmount + carolR.assetAmount + daveR.assetAmount) === 100.0

  -- The cash leg is settled by the same rule and it balances too: the seller's
  -- confirm equals the USDC he actually holds, and equals the whole pool the three
  -- buyers pledged (100 × 260).
  bobUsd  <- ownedAmount bob usdc
  bobAapl <- ownedAmount bob aapl
  bobUsd  === bobR.cashAmount
  bobUsd  === 26000.0
  bobAapl === 0.0          -- the light side filled in full

-- ---------------------------------------------------------------------------
-- TEST 17 — THE PRICE COLLAR CLAMPS THE PRINT. IT DOES NOT CANCEL THE AUCTION.
-- ---------------------------------------------------------------------------
-- WHAT THIS TEST USED TO ASSERT, AND WHY THAT WAS WRONG. It used to prove that a
-- book crossing outside the band ABORTED the whole close and settled nothing. That
-- is not what a real venue does, and on a venue that accepts unpriced MOC it is
-- indefensible: an index fund's entire instruction is "own the closing price", so
-- cancelling the close is the one outcome it cannot hedge. Worse, it hands any single
-- participant a denial of service — one oversized order drags the indicative price
-- past the band and NOBODY trades.
--
-- WHAT THE RULEBOOKS ACTUALLY SAY. They bound the PRICE and let the auction happen.
--   Nasdaq, on their own worked example (10.00 x 11.00 → band 8.95–12.05): "$8.95 is
--     the LOWEST PRICE AT WHICH THE CROSS CAN OCCUR and $12.05 is the HIGHEST PRICE
--     AT WHICH IT CAN OCCUR."
--   NYSE Rule 7.35B(g)(2): the DMM "must select an Auction Price" inside a two-
--     endpoint band. Rule 7.35C's Auction Collar is likewise a threshold on the
--     Indicative Match Price. (Its percentages are UNVERIFIED-3 in the mechanics
--     doc, so CrossDesk keeps Nasdaq's verified 10% / $0.50.)
--
-- AND THE BOUNDARY IS THE RIGHT PRICE, not a stopgap: exec(P) is the min of a
-- non-increasing and a non-decreasing function, hence quasi-concave, so the maximum
-- over a band that excludes its peak sits at the boundary nearest the peak. Clamping
-- IS constrained volume maximisation.
--
-- Book (AAPL / USDC, anchor 255 → band 229.50 to 280.50):
--   BUY  Alice 10 @ 400      SELL Bob   10 @ 300
--                            SELL Carol  4 @ 250
-- Unconstrained the uncross prints 300 and trades 10. 300 is above the band, so the
-- close prints 280.50 — and at 280.50 Bob's 300 offer is no longer eligible, so only
-- Carol's 4 cross. THE VOLUME SHRINKS FROM 10 TO 4, WHICH IS THE POINT: you cannot
-- clamp the price and keep the old quantity, because the quantity was only available
-- at a price the venue will not print.
-- ---------------------------------------------------------------------------
testPriceCollar : Script ()
testPriceCollar = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  -- THE CLAMP AS PURE ARITHMETIC. Inside the band it is the identity — an ordinary
  -- close never notices the collar — and only outside does it bind.
  clampToCollar 255.0 260.0   === 260.0     -- inside: untouched
  clampToCollar 255.0 280.5   === 280.5     -- exactly the top edge: printable as is
  clampToCollar 255.0 229.5   === 229.5     -- exactly the bottom edge: printable as is
  clampToCollar 255.0 300.0   === 280.5     -- above the band: pulled to the boundary
  clampToCollar 255.0 10000.0 === 280.5     -- far above: same boundary
  clampToCollar 255.0 100.0   === 229.5     -- below the band: pulled up

  aliceCash  <- mint issuer usdc alice 4000.0   -- 10 @ her 400 limit
  bobAsset   <- mint issuer aapl bob   10.0
  carolAsset <- mint issuer aapl carol 4.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy)  <- submitOrder auctionCid alice Buy  10.0 400.0 aliceCash
  (a2, bobSell)   <- submitOrder a1         bob   Sell 10.0 300.0 bobAsset
  (a3, carolSell) <- submitOrder a2         carol Sell  4.0 250.0 carolAsset

  -- THE UNCONSTRAINED ANSWER, AND THE CONSTRAINED ONE, side by side.
  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      book = [buy 10.0 400.0, sell 10.0 300.0, sell 4.0 250.0]
  fmap (\c -> c.price)       (discoverPrice 255.0 book) === Some 300.0
  fmap (\c -> c.executedQty) (discoverPrice 255.0 book) === Some 10.0
  assertMsg "300 must be outside a band centred on 255" (not (withinCollar 255.0 300.0))
  (crossAt book 280.5).executedQty === 4.0     -- what actually crosses at the boundary

  sealed   <- submit venue do exerciseCmd a3 CloseBidding
  -- AND THE CLOSE PRINTS. This is the line that used to be a `submitMustFail`.
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, carolSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 280.5
  assertMsg "the print must be the collar boundary, not the unconstrained 300"
    (batch.closingPrice /= 300.0)
  assertMsg "the printed price must be inside the band" (withinCollar 255.0 batch.closingPrice)
  length batch.fills === 2       -- Alice's partial buy + Carol's sell. Bob never traded.
  assertMsg "every fill prints at the clamped price"
    (all (\f -> f.price == 280.5) batch.fills)

  -- THE CROSSED VOLUME IS THE SMALLER, RE-SCORED ONE — 4, not the 10 the
  -- unconstrained price would have traded.
  let aliceFill = head (filter (\f -> f.buyer == alice) batch.fills)
  aliceFill.quantity === 4.0
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 4.0
  aliceUsd  === 2878.0        -- reserved 4,000 at her limit, paid 4 × 280.50 = 1,122

  -- Carol's cheap offer filled in full at the clamped print.
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 0.0
  carolUsd  === 1122.0

  -- THE EXCESS RETURNS INTACT. Bob wanted 300 and the venue will not print above
  -- 280.50, so his offer is away from the CLAMPED cross: cancelled on close, no fill
  -- record, and every one of his 10 units still his. Clamping bounds the price — it
  -- never drags anybody through their own limit.
  assertMsg "an order away from the CLAMPED print is cancelled on close" . isNone
    =<< queryContractId venue bobSell
  assertMsg "the clamped-out order must have no fill record"
    (null (filter (\f -> f.seller == bob) batch.fills))
  bobAapl <- ownedAmount bob aapl
  bobUsd  <- ownedAmount bob usdc
  bobAapl === 10.0
  bobUsd  === 0.0

-- ---------------------------------------------------------------------------
-- TEST 17a — THE COLLAR CLAMPS DOWNWARD TOO.
-- ---------------------------------------------------------------------------
-- The mirror image, because a band with only one working edge is not a band. A
-- sell-heavy book drags the unconstrained print DOWN below the floor of the collar,
-- and the close prints at the LOWER boundary instead — again re-crossing there, and
-- again leaving the interest that was reaching past the band untouched.
--
-- Book (AAPL / USDC, anchor 255 → band 229.50 to 280.50):
--   SELL Bob 10 @ 100        BUY Alice 10 @ 200
--                            BUY Carol  4 @ 260
-- Unconstrained the uncross prints 200 (both surviving prices are bid-heavy, so
-- market pressure takes the higher of them) and trades 10. 200 is below the band, so
-- the close prints 229.50, where Alice's 200 bid is no longer eligible and only
-- Carol's 4 cross.
-- ---------------------------------------------------------------------------
testCollarClampsDown : Script ()
testCollarClampsDown = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  aliceCash <- mint issuer usdc alice 2000.0   -- 10 @ her 200 limit
  carolCash <- mint issuer usdc carol 1040.0   --  4 @ her 260 limit
  bobAsset  <- mint issuer aapl bob   10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder auctionCid bob   Sell 10.0 100.0 bobAsset
  (a2, aliceBuy) <- submitOrder a1         alice Buy  10.0 200.0 aliceCash
  (a3, carolBuy) <- submitOrder a2         carol Buy   4.0 260.0 carolCash

  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      book = [buy 10.0 200.0, buy 4.0 260.0, sell 10.0 100.0]
  fmap (\c -> c.price)       (discoverPrice 255.0 book) === Some 200.0
  fmap (\c -> c.executedQty) (discoverPrice 255.0 book) === Some 10.0
  assertMsg "200 must be below a band centred on 255" (not (withinCollar 255.0 200.0))
  clampToCollar 255.0 200.0 === 229.5
  (crossAt book 229.5).executedQty === 4.0

  sealed   <- submit venue do exerciseCmd a3 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, carolBuy]
      sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 229.5
  length batch.fills === 2

  -- Carol bid through the clamped print and fills all 4 at 229.50 = 918, with 122 of
  -- change back off her 1,040 reservation.
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 4.0
  carolUsd  === 122.0
  -- Bob is the heavy side, re-scored at the boundary: 4 of his 10 fill for 918, and
  -- the other 6 units come home to him.
  bobAapl <- ownedAmount bob aapl
  bobUsd  <- ownedAmount bob usdc
  bobAapl === 6.0
  bobUsd  === 918.0
  -- Alice's 200 bid is away from the CLAMPED cross — cancelled on close, and every
  -- cent she committed is still hers.
  assertMsg "a bid below the clamped print is cancelled on close" . isNone
    =<< queryContractId venue aliceBuy
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 0.0
  aliceUsd  === 2000.0

-- ---------------------------------------------------------------------------
-- TEST 17b — AN UNPRICED BUY IS FULLY FUNDED AT A CLAMPED PRINT. THE TIGHTEST CASE.
-- ---------------------------------------------------------------------------
-- THE INVARIANT UNDER TEST. An unpriced buy reserves `quantity × (anchor +
-- collarBand anchor)` — the highest price the close can legally print. Clamping is
-- what makes that bound TIGHT rather than merely sufficient: the upper boundary is
-- not a theoretical ceiling any more, it is a price the venue will actually print
-- when the book reaches past it. So the tightest possible case for the reservation is
-- exactly this one — an MOC buy filling IN FULL at a CLAMPED upper boundary — and it
-- has to settle to the cent.
--
-- Book (AAPL / USDC, anchor 100 → band 90 to 110):
--   BUY Alice 10 UNPRICED (MOC)      SELL Carol 12 @ 105
--   BUY Dave  20 @ 200 (LOC)
-- Every volume-maximising price is buy-heavy, so market pressure takes the print to
-- 200 — far above the band. The close clamps to 110 and re-crosses: 12 units are
-- available there. Class priority gives the MOC all 10 first, and Dave takes the
-- remaining 2. Alice therefore fills IN FULL at the very top of the band and owes
-- 10 × 110 = 1,100 — which is EXACTLY what she reserved. She is minted that and not a
-- cent more, so this close can only settle if the collar-sized reservation is right.
-- ---------------------------------------------------------------------------
testUnpricedBuyFundedAtClampedBoundary : Script ()
testUnpricedBuyFundedAtClampedBoundary = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  collarBand 100.0 === 10.0
  clampToCollar 100.0 200.0 === 110.0

  -- EXACTLY the collar-sized reservation and no slack at all: 10 × (100 + 10).
  aliceCash  <- mint issuer usdc alice 1100.0
  daveCash   <- mint issuer usdc dave  4000.0    -- 20 @ his 200 limit
  carolAsset <- mint issuer aapl carol 12.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 100.0
      participants = [alice, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy)  <- submitMocOrder auctionCid alice Buy  10.0       aliceCash
  (a2, daveBuy)   <- submitOrder    a1         dave  Buy  20.0 200.0 daveCash
  (a3, carolSell) <- submitOrder    a2         carol Sell 12.0 105.0 carolAsset

  sealed   <- submit venue do exerciseCmd a3 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, daveBuy]
      sellOrders = [carolSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 110.0
  batch.closingPrice === 100.0 + collarBand 100.0
  length batch.fills === 3

  -- THE ASSERTION THIS TEST EXISTS FOR: the MOC filled in full at the top of the
  -- band and spent its whole reservation, to the cent, with no shortfall and no
  -- change. `quantity × collarHigh` is exact, not conservative.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 10.0
  aliceUsd  === 0.0
  -- Class priority still runs at a clamped price: the MOC took its 10 first and the
  -- limit order behind it got the 2 that were left, at the same one print.
  daveAapl <- ownedAmount dave aapl
  daveUsd  <- ownedAmount dave usdc
  daveAapl === 2.0
  daveUsd  === 3780.0      -- reserved 4,000 at his limit, paid 2 × 110 = 220
  -- The seller filled in full at the boundary: 12 × 110 = 1,320.
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 0.0
  carolUsd  === 1320.0

-- ---------------------------------------------------------------------------
-- TEST 17c — A PRINT INSIDE THE BAND IS UNTOUCHED (the no-regression guard).
-- ---------------------------------------------------------------------------
-- Clamping must be invisible on an ordinary close. `clampToCollar` is the identity
-- everywhere inside the band INCLUDING both edges, so the uncross's answer survives
-- unchanged and the collar costs a normal auction nothing at all. Every other script
-- in this file is really a second copy of this assertion; this one states it on
-- purpose so a future change to the collar cannot quietly move a normal print.
-- ---------------------------------------------------------------------------
testInBandPrintIsNotClamped : Script ()
testInBandPrintIsNotClamped = do
  Parties{..} <- setup
  setupInstruments issuer

  -- The identity, edge to edge.
  clampToCollar 255.0 229.5 === 229.5
  clampToCollar 255.0 255.0 === 255.0
  clampToCollar 255.0 280.5 === 280.5
  -- ...and only a hair outside does it move at all.
  clampToCollar 255.0 280.51 === 280.5
  clampToCollar 255.0 229.49 === 229.5

  aliceCash <- mint issuer usdc alice 2600.0   -- 10 @ her 260 limit
  bobAsset  <- mint issuer aapl bob   10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy) <- submitOrder auctionCid alice Buy  10.0 260.0 aliceCash
  (a2, bobSell)  <- submitOrder a1         bob   Sell 10.0 250.0 bobAsset

  -- The uncross says 255 and 255 is inside the band, so 255 is what prints — the
  -- collar did not participate in this close at all.
  let buy  q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      book = [buy 10.0 260.0, sell 10.0 250.0]
  fmap (\c -> c.price) (discoverPrice 255.0 book) === Some 255.0

  sealed   <- submit venue do exerciseCmd a2 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 2
  -- Full crossed volume, both sides, exactly as before the collar learned to clamp.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bobAapl   <- ownedAmount bob   aapl
  bobUsd    <- ownedAmount bob   usdc
  aliceAapl === 10.0
  aliceUsd  === 50.0
  bobAapl   === 0.0
  bobUsd    === 2550.0

-- ===========================================================================
-- TESTS 18–23 — THE UNPRICED MARKET-ON-CLOSE ORDER.
-- ===========================================================================
-- Until now every SealedOrder carried a limit, so every order in this book was
-- really a LIMIT-on-close — a price SETTER. Real closing volume is overwhelmingly
-- UNPRICED MOC: index funds tracking a benchmark that is struck AT the official
-- close, rebalancers whose mandate IS the print, ETF create/redeem flow. They are
-- price TAKERS, and until `limitPrice` became `Optional Decimal` this venue could
-- not represent one of them. These six scripts pin down what the order type does.
-- ===========================================================================

-- ---------------------------------------------------------------------------
-- TEST 18 — CLASS BEATS PRICE: an unpriced MOC fills ahead of a limit order.
-- ---------------------------------------------------------------------------
-- Nasdaq Rule 4754(b)(3) allocates the closing cross by ORDER CLASS → price →
-- display → time, and rung (A) is verbatim "MOC orders, with time as the secondary
-- priority". Euronext says it in one sentence (Trading Manual §2.2.7): "during
-- uncrossing market orders have priority over orders limited at the uncrossing
-- price." So an MOC does not merely tie with a limit order at the print — it is
-- allocated BEFORE it, and the limit order can be left with nothing.
--
-- Book (AAPL / USDC, anchor 255):
--   SELL Bob  10 @ 250              BUY Alice 10 UNPRICED (MOC)
--                                   BUY Carol 10 @ 260   (LOC)
-- Every candidate trades 10 and leaves the same 10 of unfilled demand, so market
-- pressure prints at the top of the range: 260. Carol's limit is EXACTLY the print,
-- which makes hers the marginal level — and the marginal level is what gets rationed.
-- Alice's MOC takes the whole 10 first, and there is nothing left for Carol.
--
-- WHY THE RULE IS RIGHT, NOT JUST WRITTEN DOWN. Alice gave up the only protection
-- she had — she accepted the print sight unseen. Carol kept hers to the last instant
-- and is being filled at the very best price she was ever willing to pay. Rank them
-- equally and no rational index fund ever sends an unpriced order again.
-- ---------------------------------------------------------------------------
testMocClassPriority : Script ()
testMocClassPriority = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  -- THE ALLOCATION RULE FIRST, AS PURE ARITHMETIC. The MOC is listed SECOND on
  -- purpose: precedence comes from the CLASS, not from array position, and both
  -- orders here are eligible at the print.
  allocateSide Buy 10.0 [("loc260", Some 260.0, 10.0), ("moc", None, 10.0)]
    === [("moc", 10.0), ("loc260", 0.0)]

  bobAsset  <- mint issuer aapl bob   10.0
  -- Alice's MOC reserves at the TOP OF THE COLLAR: 10 × (255 + 25.50) = 2,805.
  aliceCash <- mint issuer usdc alice 2805.0
  -- Carol's LOC reserves at her own limit: 10 × 260 = 2,600.
  carolCash <- mint issuer usdc carol 2600.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder    auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, aliceBuy) <- submitMocOrder a1         alice Buy  10.0       aliceCash
  (a3, carolBuy) <- submitOrder    a2         carol Buy  10.0 260.0 carolCash

  sealed   <- submit venue do exerciseCmd a3 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, carolBuy]
      sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 260.0
  -- TWO fill records: Alice's buy and Bob's sell. Carol traded nothing at all.
  length batch.fills === 2
  assertMsg "the limit order at the print must not appear in the batch"
    (null (filter (\f -> f.buyer == carol) batch.fills))

  -- THE MOC TOOK THE WHOLE CROSS. Alice bought all 10 at 260 (2,600) and got the
  -- 205 of change back off the collar-sized reservation she never had to spend.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 10.0
  aliceUsd  === 205.0
  -- CAROL GOT NOTHING, AND LOST NOTHING. Her order was allocated zero, so it is
  -- cleared off the book exactly like any other order that did not trade, and every
  -- cent she committed is still hers — the archive touches the ORDER, never the
  -- balance. Being outranked is not being charged.
  assertMsg "an outranked limit order is cancelled on close, not left resting" . isNone
    =<< queryContractId venue carolBuy
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 0.0
  carolUsd  === 2600.0
  -- Bob sold his 10 at the print.
  bobUsd  <- ownedAmount bob usdc
  bobAapl <- ownedAmount bob aapl
  bobUsd  === 2600.0
  bobAapl === 0.0

-- ---------------------------------------------------------------------------
-- TEST 19 — AN ALL-UNPRICED BOOK PRINTS AT THE ANCHOR.
-- ---------------------------------------------------------------------------
-- MOC against MOC contains NO PRICE INFORMATION. Nobody in the book has expressed a
-- view; every participant has said "give me the close, whatever it is". There is
-- nothing for a volume-maximising search to maximise over, because every price
-- trades exactly the same quantity. Both European venues publish the same answer:
--   Xetra T7 §11.1.1 step 5: "If only market orders are executable against one
--     another, they are matched at the reference price."
--   Euronext Trading Manual §3.1: the same rule, same wording.
-- So the print is the venue's anchor, and the volume is min(unpriced buys, unpriced
-- sells). `discoverPrice` handles it as its own explicit branch — with no limits in
-- the book there are no candidate prices to draw from, so the anchor is the only
-- price in play.
--
-- Book (AAPL / USDC, anchor 255):  BUY Alice 5 UNPRICED   SELL Bob 8 UNPRICED
-- ---------------------------------------------------------------------------
testAllUnpricedBookPrintsAtAnchor : Script ()
testAllUnpricedBookPrintsAtAnchor = do
  Parties{..} <- setup
  setupInstruments issuer

  -- THE ARITHMETIC FIRST. Five units trade at the anchor and three are stranded on
  -- the sell side — and the print follows the anchor wherever the venue puts it,
  -- because the orders have said nothing to contradict it.
  let mktBuy  q = BookOrder with side = Buy;  quantity = q; limitPrice = None
      mktSell q = BookOrder with side = Sell; quantity = q; limitPrice = None
      priceOf   = fmap (\c -> c.price)
      allMoc    = [mktBuy 5.0, mktSell 8.0]
  discoverPrice 255.0 allMoc === Some (CrossResult with
    price = 255.0; executedQty = 5.0; buyVolume = 5.0; sellVolume = 8.0; imbalance = -3.0)
  priceOf (discoverPrice 100.0 allMoc) === Some 100.0    -- same book, anchor moved
  -- And an all-unpriced book with only ONE side still does not cross: nobody to
  -- trade with is nobody to trade with, whatever the order type.
  discoverPrice 255.0 [mktBuy 5.0] === None

  -- Alice's MOC reserves at the top of the collar: 5 × (255 + 25.50) = 1,402.50.
  aliceCash <- mint issuer usdc alice 1402.5
  bobAsset  <- mint issuer aapl bob   8.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy) <- submitMocOrder auctionCid alice Buy  5.0 aliceCash
  (a2, bobSell)  <- submitMocOrder a1         bob   Sell 8.0 bobAsset

  sealed   <- submit venue do exerciseCmd a2 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]

  -- THE PRINT IS THE ANCHOR, and it is the only honest answer available.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 2

  -- Alice bought 5 at 255 (1,275) and got 127.50 of change back off the collar-sized
  -- reservation. Bob sold 5 of the 8 he offered — the unpriced sell side was the
  -- heavy one and is rationed down to the crossed volume — and keeps the other 3.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  bobAapl   <- ownedAmount bob   aapl
  bobUsd    <- ownedAmount bob   usdc
  aliceAapl === 5.0
  aliceUsd  === 127.5
  bobAapl   === 3.0
  bobUsd    === 1275.0

-- ---------------------------------------------------------------------------
-- TEST 20 — THE WHOLE LADDER ON ONE BOOK.
-- ---------------------------------------------------------------------------
-- Class → price → margin, all three rungs visible in a single close:
--   (a) the UNPRICED MOC fills in full, ahead of everything;
--   (b) the limit priced THROUGH the print fills in full;
--   (c) the limit AT the print is the marginal level, and is the only one rationed.
--
-- Book (AAPL / USDC, anchor 255):
--   SELL Bob 15 @ 250        BUY Alice  5 UNPRICED (MOC)
--                            BUY Carol  5 @ 260    (through the print)
--                            BUY Dave  10 @ 255    (AT the print — the margin)
-- 20 units of demand into 15 of supply. 250 and 255 both trade 15 and both leave the
-- same 5 of unfilled demand; every survivor is buy-heavy, so market pressure prints
-- at the top of them — 255. The buy side is therefore rationed, but NOT uniformly:
-- Alice 5 (class), Carol 5 (price), Dave 5 of his 10 (the margin).
-- ---------------------------------------------------------------------------
testMocLocLadderEndToEnd : Script ()
testMocLocLadderEndToEnd = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  -- THE LADDER AS PURE ARITHMETIC, before a single leg moves.
  allocateSide Buy 15.0
    [("dave255", Some 255.0, 10.0), ("carol260", Some 260.0, 5.0), ("aliceMoc", None, 5.0)]
    === [("aliceMoc", 5.0), ("carol260", 5.0), ("dave255", 5.0)]

  bobAsset  <- mint issuer aapl bob   15.0
  aliceCash <- mint issuer usdc alice 1402.5   -- MOC:  5 × (255 + 25.50)
  carolCash <- mint issuer usdc carol 1300.0   -- LOC:  5 × 260
  daveCash  <- mint issuer usdc dave  2550.0   -- LOC: 10 × 255

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder    auctionCid bob   Sell 15.0 250.0 bobAsset
  (a2, aliceBuy) <- submitMocOrder a1         alice Buy   5.0       aliceCash
  (a3, carolBuy) <- submitOrder    a2         carol Buy   5.0 260.0 carolCash
  (a4, daveBuy)  <- submitOrder    a3         dave  Buy  10.0 255.0 daveCash

  sealed   <- submit venue do exerciseCmd a4 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, carolBuy, daveBuy]
      sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 255.0
  length batch.fills === 4          -- 3 buys + 1 sell; everybody traded something
  assertMsg "every fill prints at the ONE discovered price"
    (all (\f -> f.price == 255.0) batch.fills)

  -- (a) THE MOC FILLED IN FULL — 5 at 255 = 1,275, with 127.50 of change back off
  --     the collar-sized reservation it never had to spend.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 5.0
  aliceUsd  === 127.5
  -- (b) THROUGH THE PRINT FILLED IN FULL — Carol bid 260 into a 255 print, so she is
  --     guaranteed to participate and takes all 5, paying 1,275 with 25 back.
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 5.0
  carolUsd  === 25.0
  -- (c) THE MARGINAL LEVEL WAS RATIONED — Dave bid AT the print, so his is the level
  --     the crossed volume ran out on: 5 of his 10 fill, and the 1,275 he did not
  --     spend comes straight back to him.
  daveAapl <- ownedAmount dave aapl
  daveUsd  <- ownedAmount dave usdc
  daveAapl === 5.0
  daveUsd  === 1275.0
  -- The fill records say the same thing the balances do.
  let aliceFill = head (filter (\f -> f.buyer == alice) batch.fills)
      carolFill = head (filter (\f -> f.buyer == carol) batch.fills)
      daveFill  = head (filter (\f -> f.buyer == dave ) batch.fills)
  aliceFill.quantity === 5.0
  carolFill.quantity === 5.0
  daveFill.quantity  === 5.0
  -- The light side filled in full: Bob sold all 15 at 255 for 3,825.
  bobAapl <- ownedAmount bob aapl
  bobUsd  <- ownedAmount bob usdc
  bobAapl === 0.0
  bobUsd  === 3825.0

-- ---------------------------------------------------------------------------
-- TEST 21 — THE CRUX: AN UNPRICED BUY FUNDED WHEN THE PRINT LANDS ABOVE THE ANCHOR.
-- ---------------------------------------------------------------------------
-- THE PROBLEM THAT KEPT MOC OFF THIS VENUE. A sealed order pre-commits the holding
-- it will deliver, and the amount is pinned at SUBMISSION time — before a price
-- exists. A limited buy is easy: it can only ever execute at or inside its own limit,
-- so `quantity × limitPrice` is an exact worst case. AN UNPRICED BUY HAS NO LIMIT AND
-- THEREFORE NO NATURAL BOUND ON WHAT IT MAY OWE. Reserve at the anchor and the buyer
-- is short the instant the book uncrosses above it — which is not an edge case, it is
-- an ordinary buy-heavy close.
--
-- THE ANSWER IS THE COLLAR. The print is not unbounded here: `RunClose` will not
-- settle outside `anchor ± collarBand anchor`. So the highest price this auction can
-- LEGALLY print is `anchor + collarBand anchor`, and reserving there is sufficient BY
-- CONSTRUCTION — either the print is inside the band and the reservation covers it,
-- or nothing settles at all and the buyer keeps every cent. A risk control written
-- for price integrity turns out to be exactly the bound that makes an unpriced order
-- fundable.
--
-- Book (AAPL / USDC, anchor 100 → band ±10 → the close may print anywhere in
-- [90, 110]):
--   BUY Alice 10 UNPRICED       SELL Bob 10 @ 110
-- At the anchor Bob's offer is not eligible and NOTHING trades. The only crossing
-- price is 110 — the very top of the band, 10% above the anchor. Alice reserved
-- 10 × 110 = 1,100 and owes exactly 1,100: the bound is not merely sufficient, it is
-- TIGHT. She is minted exactly that and not a cent more, so the close can only settle
-- if the collar-sized reservation was right.
-- ---------------------------------------------------------------------------
testUnpricedBuyFundedAboveTheAnchor : Script ()
testUnpricedBuyFundedAboveTheAnchor = do
  Parties{..} <- setup
  setupInstruments issuer

  -- The band, as arithmetic: 10% of a 100 anchor beats the $0.50 floor, so the close
  -- may legally print as high as 110 — and that is the number the reservation uses.
  collarBand 100.0 === 10.0
  assertMsg "the top of the band must be printable"      (withinCollar 100.0 110.0)
  assertMsg "a hair above the band must not be printable" (not (withinCollar 100.0 110.01))

  -- EXACTLY the collar-sized reservation, and not one cent of slack: 10 × 110.
  aliceCash <- mint issuer usdc alice 1100.0
  bobAsset  <- mint issuer aapl bob   10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 100.0
      participants = [alice, bob]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy) <- submitMocOrder auctionCid alice Buy  10.0       aliceCash
  (a2, bobSell)  <- submitOrder    a1         bob   Sell 10.0 110.0 bobAsset

  sealed   <- submit venue do exerciseCmd a2 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with buyOrders = [aliceBuy]; sellOrders = [bobSell]

  -- THE PRINT IS 10% ABOVE THE ANCHOR — the highest the collar allows — and the
  -- close settled anyway, because the reservation was sized on that same bound.
  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 110.0
  batch.closingPrice === 100.0 + collarBand 100.0
  length batch.fills === 2

  -- THE COUNTERFACTUAL, STATED AS ARITHMETIC. Reserving at the anchor would have
  -- pinned 1,000 against a bill of 1,100 — the buyer short by 100, the pledge
  -- refused, and the WHOLE close aborted for everybody in the book.
  let anchorSizedReserve = (10.0 * 100.0 : Decimal)
      actualCost         = (10.0 * 110.0 : Decimal)
  assertMsg "reserving at the ANCHOR would have left the MOC buyer short"
    (anchorSizedReserve < actualCost)

  -- Alice owns the close: 10 units, and every cent of the reservation spent, with no
  -- change and — crucially — no shortfall.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 10.0
  aliceUsd  === 0.0
  bobAapl <- ownedAmount bob aapl
  bobUsd  <- ownedAmount bob usdc
  bobAapl === 0.0
  bobUsd  === 1100.0

-- ---------------------------------------------------------------------------
-- TEST 22 — UNPRICED INTEREST BIGGER THAN THE CROSS RATIONS AMONG THE UNPRICED.
-- ---------------------------------------------------------------------------
-- Nasdaq Rule 4754(b)(3) rung (A) allocates MOC first "with time as the secondary
-- priority" — so when unpriced interest ALONE exceeds the crossed volume, the
-- rationing happens INSIDE the MOC class and nothing priced fills at all. That is not
-- a corner case: an index reconstitution day is exactly a book where the unpriced
-- side dwarfs everything else.
--
-- CrossDesk rations that level pro-rata BY SIZE rather than on time, for the reason
-- given in the module header: a SealedOrder carries no on-ledger arrival timestamp,
-- so the only "time" available at the close is the order of the array the OPERATOR
-- hands to RunClose — and rationing on that would let the venue choose who fills by
-- permuting a list. Pro-rata by size is invariant to that permutation.
--
-- Book (AAPL / USDC, anchor 255):
--   SELL Bob 10 @ 250     BUY Alice 10 UNPRICED   BUY Carol 30 UNPRICED
--                         BUY Dave  10 @ 260 (LOC — behind BOTH of them)
-- Every candidate trades 10 and is buy-heavy by 40, so the print goes to the top:
-- 260. Forty units of unpriced demand chase ten units of supply: Alice takes
-- 10 × 10/40 = 2.5, Carol takes 30 × 10/40 = 7.5, and Dave — bidding 260 INTO a 260
-- print, the best price he could possibly have named — gets nothing.
-- ---------------------------------------------------------------------------
testUnpricedInterestRationedProRata : Script ()
testUnpricedInterestRationedProRata = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")
  dave  <- allocatePartyByHint (PartyIdHint "Dave")

  -- PURE ARITHMETIC FIRST: pro-rata WITHIN the unpriced class, zero for the limit.
  allocateSide Buy 10.0
    [("mocA", None, 10.0), ("mocC", None, 30.0), ("loc260", Some 260.0, 10.0)]
    === [("mocA", 2.5), ("mocC", 7.5), ("loc260", 0.0)]

  bobAsset  <- mint issuer aapl bob   10.0
  aliceCash <- mint issuer usdc alice 2805.0   -- MOC: 10 × (255 + 25.50)
  carolCash <- mint issuer usdc carol 8415.0   -- MOC: 30 × (255 + 25.50)
  daveCash  <- mint issuer usdc dave  2600.0   -- LOC: 10 × 260

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 255.0
      participants = [alice, bob, carol, dave]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, bobSell)  <- submitOrder    auctionCid bob   Sell 10.0 250.0 bobAsset
  (a2, aliceBuy) <- submitMocOrder a1         alice Buy  10.0       aliceCash
  (a3, carolBuy) <- submitMocOrder a2         carol Buy  30.0       carolCash
  (a4, daveBuy)  <- submitOrder    a3         dave  Buy  10.0 260.0 daveCash

  sealed   <- submit venue do exerciseCmd a4 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy, carolBuy, daveBuy]
      sellOrders = [bobSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 260.0
  length batch.fills === 3          -- 2 unpriced buys + 1 sell. Dave is not there.

  -- PRO-RATA BY SIZE INSIDE THE CLASS: 10 and 30 share the 10 that crossed, and the
  -- two fills sum EXACTLY to the crossed volume.
  let aliceFill = head (filter (\f -> f.buyer == alice) batch.fills)
      carolFill = head (filter (\f -> f.buyer == carol) batch.fills)
  aliceFill.quantity === 2.5
  carolFill.quantity === 7.5
  (aliceFill.quantity + carolFill.quantity) === 10.0

  aliceAapl <- ownedAmount alice aapl
  carolAapl <- ownedAmount carol aapl
  aliceAapl === 2.5
  carolAapl === 7.5
  -- Change back off the collar-sized reservations: Alice spent 2.5 × 260 = 650 of
  -- 2,805; Carol spent 7.5 × 260 = 1,950 of 8,415.
  aliceUsd <- ownedAmount alice usdc
  carolUsd <- ownedAmount carol usdc
  aliceUsd === 2155.0
  carolUsd === 6465.0

  -- THE LIMIT ORDER BEHIND THEM GETS NOTHING — and is charged nothing. Dave bid the
  -- print exactly and was still outranked by the class above him; his order is
  -- cleared off the book and all 2,600 he committed is still his.
  assertMsg "a limit order behind unpriced interest is cancelled on close" . isNone
    =<< queryContractId venue daveBuy
  daveAapl <- ownedAmount dave aapl
  daveUsd  <- ownedAmount dave usdc
  daveAapl === 0.0
  daveUsd  === 2600.0

  -- Bob sold his 10 at the print.
  bobUsd <- ownedAmount bob usdc
  bobUsd === 2600.0

-- ---------------------------------------------------------------------------
-- TEST 23 — AN UNPRICED ORDER IS NEVER "AWAY FROM THE CROSS".
-- ---------------------------------------------------------------------------
-- The close splits the book into interest that trades and interest that is CANCELLED
-- for sitting away from the print. An unpriced order can never be on the wrong side
-- of that split, because there is no price at which a market order is off-price —
-- that is the whole content of the order type. It has to be true in all three places
-- the close asks the question (the uncross's volume count, the eligibility split, and
-- the pledge's own assert), which is why all three now read from ONE `eligibleAt`.
--
-- Book (AAPL / USDC, anchor 250 → band ±25):
--   BUY  Alice 10 @ 230      SELL Bob   10 UNPRICED (MOC)
--                            SELL Carol 10 @ 245    (LOC)
-- The only price that trades anything is 230 — twenty points below the anchor and
-- fifteen below Carol's limit. Carol is away from the cross and is cancelled. BOB
-- TRADES ANYWAY, at a price he never named and would very likely not have named,
-- because that is what he asked for: the close, whatever it is. That is the MOC
-- bargain in one line, and it is why an MOC must never be cancelled for being
-- off-price — there is no such thing.
-- ---------------------------------------------------------------------------
testMocIsNeverAwayFromTheCross : Script ()
testMocIsNeverAwayFromTheCross = do
  Parties{..} <- setup
  setupInstruments issuer
  carol <- allocatePartyByHint (PartyIdHint "Carol")

  -- WILLING AT ANY PRICE, AS ARITHMETIC. Sweep the candidate price from absurdly low
  -- to absurdly high: the unpriced sell is counted at BOTH ends, and the limited sell
  -- beside it only appears once the price reaches its limit. The MOC is the constant.
  let buy   q p = BookOrder with side = Buy;  quantity = q; limitPrice = Some p
      sell  q p = BookOrder with side = Sell; quantity = q; limitPrice = Some p
      mktSell q = BookOrder with side = Sell; quantity = q; limitPrice = None
      book      = [mktSell 10.0, sell 10.0 245.0, buy 10.0 230.0]
  (crossAt book      1.0).sellVolume === 10.0     -- only the MOC is in down here
  (crossAt book 100000.0).sellVolume === 20.0     -- the limit joins it up here
  fmap (\c -> c.price) (discoverPrice 250.0 book) === Some 230.0

  aliceCash  <- mint issuer usdc alice 2300.0   -- LOC: 10 × 230
  bobAsset   <- mint issuer aapl bob   10.0     -- an MOC sell reserves the ASSET, as always
  carolAsset <- mint issuer aapl carol 10.0

  auctionCid <- submit venue do
    createCmd ClosingAuction with
      operator = venue; auditor; instrumentId = aapl; cashInstrument = usdc
      session = "Close"; referencePrice = 250.0
      participants = [alice, bob, carol]; liquidityProvider = None; fixingRef = None
      submittedCount = 0; cancelledCount = 0; isOpen = True

  (a1, aliceBuy)  <- submitOrder    auctionCid alice Buy  10.0 230.0 aliceCash
  (a2, bobSell)   <- submitMocOrder a1         bob   Sell 10.0       bobAsset
  (a3, carolSell) <- submitOrder    a2         carol Sell 10.0 245.0 carolAsset

  sealed   <- submit venue do exerciseCmd a3 CloseBidding
  batchCid <- submit venue do
    exerciseCmd sealed RunClose with
      buyOrders  = [aliceBuy]
      sellOrders = [bobSell, carolSell]

  Some batch <- queryContractId auditor batchCid
  batch.closingPrice === 230.0
  length batch.fills === 2

  -- THE MOC TRADED, twenty points below the anchor and at a price it never named.
  let bobFill = head (filter (\f -> f.seller == bob) batch.fills)
  bobFill.quantity === 10.0
  bobFill.price    === 230.0
  bobAapl <- ownedAmount bob aapl
  bobUsd  <- ownedAmount bob usdc
  bobAapl === 0.0
  bobUsd  === 2300.0

  -- THE LIMIT ORDER BESIDE IT DID NOT. Carol's 245 offer is away from the 230 cross,
  -- so she gets no fill record and her order is cancelled on close — she keeps all 10
  -- units. Same side, same size, same book: the ONLY difference is the order type.
  assertMsg "an away-from-the-cross LIMIT sell must be cancelled on close" . isNone
    =<< queryContractId venue carolSell
  assertMsg "the away-from-the-cross order must have no fill record"
    (null (filter (\f -> f.seller == carol) batch.fills))
  carolAapl <- ownedAmount carol aapl
  carolUsd  <- ownedAmount carol usdc
  carolAapl === 10.0
  carolUsd  === 0.0

  -- Alice bought her 10 at her own limit, spending the whole reservation.
  aliceAapl <- ownedAmount alice aapl
  aliceUsd  <- ownedAmount alice usdc
  aliceAapl === 10.0
  aliceUsd  === 0.0

