# DAML build artifacts
.daml/
*.dar

# ...EXCEPT the vendored CIP-56 / Canton Network Token Standard interface DARs.
# These are official, unmodified `splice-api-token-*` release artifacts, not
# build output, and they are committed deliberately so that `daml build` is
# reproducible without a checkout of the Splice repo. See docs/TOKEN_STANDARD_DVP.md.
!deps/*.dar

# DAML / Canton runtime & logs
canton.log
log/
*.log

# Node (any tooling / scripts)
node_modules/

# Backend (Spring Boot / Gradle) build artifacts. The Gradle WRAPPER
# (backend/gradlew, backend/gradle/wrapper/*) and the committed Daml codegen
# output (backend/src/main/generated-java/**) are intentionally NOT ignored.
backend/build/
backend/.gradle/
backend-devnet/build/
backend-devnet/.gradle/
.gradle/

# Secrets & local config — NEVER commit Devnet credentials / participant keys
.env
.env.*
# ...except the template, which carries no values — only the names to fill in.
!.env.example
*.pem
*.key
*.jwt
.jwt
participant.conf.local

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Cloud Run deploy artifact (prebuilt jar) + token files
backend-devnet/cloudrun/app.jar
*refresh*.txt
crossdesk-env.yaml

# Personal social-media drafts — never push
social/

# Firebase hosting deploy cache
frontend/.firebase/

# ---- IDE build output ----
# Eclipse/VS Code compile into bin/ alongside Gradle's build/. 1,572 .class files
# regenerated by every compile — they are not source and they conflict on every pull.
bin/

# ---- gstack browse tooling ----
# Session logs from the headless browser skill. Local diagnostics, not project state.
.gstack/
