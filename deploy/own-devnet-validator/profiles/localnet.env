# =============================================================================
# Track A — Splice LocalNet 0.8.1 on this laptop (Docker Desktop).
# Loaded by lib/common.sh when CD_PROFILE=localnet.
#
# LocalNet's app-provider participant is the stand-in for OUR validator's participant:
# same Canton (3.5.17), same Splice apps (0.8.1), same HMAC auth shape. The only values
# that differ from profiles/own-devnet.env are the ones below.
#
# CD_HMAC_SECRET_REF=literal:unsafe is NOT a secret: it is the development value LocalNet
# ships in conf/canton/app-provider/app-auth.conf. Never use literal: for own-devnet.
# =============================================================================

# nginx in front of the app-provider validator (routes by Host: json-ledger-api.localhost,
# wallet.localhost, grpc-ledger-api.localhost)
CD_NGINX=http://localhost:3000
# JSON Ledger API of the app-provider participant, direct (3${PARTICIPANT_JSON_API_PORT_SUFFIX})
CD_JSON_API=http://localhost:3975

# what the backend's gRPC client dials (LedgerConnection)
CD_LEDGER_HOST=localhost
CD_LEDGER_PORT=3901
CD_LEDGER_TLS=false
CD_LEDGER_AUTHORITY=

# token shape the participant accepts (unsafe-jwt-hmac-256, target-audience)
CD_TOKEN_AUDIENCE=https://canton.network.global
CD_HMAC_SECRET_REF=literal:unsafe

# ledger users
CD_ADMIN_USER=ledger-api-user          # participant admin (allocates parties, uploads DARs)
CD_BACKEND_USER=crossdesk-backend      # least-privilege user the desk runs as
CD_WALLET_USER=app-provider            # owns the validator wallet party (holds Amulet / CC)
CD_VALIDATOR_AUDIENCE=https://canton.network.global

# parties: <hint><suffix>::<participant namespace>
CD_PARTY_HINTS="issuer bank alice bob auditor venue agent"
CD_PARTY_SUFFIX=-crossdesk

# CIP-56 registry for Amulet (the LocalNet stand-in for BitSafe CBTC): Scan serves the
# token-standard registry API; routed by Host: scan.localhost on the SV nginx.
CD_SCAN=http://localhost:4000
CD_SCAN_HOST=scan.localhost
# The desk's Java HTTP client cannot resolve *.localhost or set Host, so localnet/up.sh runs
# a socat sidecar publishing Scan (splice:5012) on 127.0.0.1:5012. Keyed by label "DSO".
CD_REGISTRY_REMOTE_URLS=DSO=http://127.0.0.1:5012

# the desk (run locally, see localnet/run-backend-localnet.sh)
CD_BACKEND_URL=http://localhost:8080
