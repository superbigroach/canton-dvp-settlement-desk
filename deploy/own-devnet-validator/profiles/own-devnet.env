# =============================================================================
# Track B — our own Splice 0.8.1 validator on GCP (crossdesk-devnet-app), DevNet.
# Loaded by lib/common.sh when CD_PROFILE=own-devnet.
#
# Operator scripts (04, 05, 07) reach the node through an IAP SSH tunnel that forwards
# the VM's 127.0.0.1:80 nginx and 127.0.0.1:7575 JSON Ledger API to this laptop:
#
#   gcloud compute ssh crossdesk-validator --zone us-central1-a --project crossdesk-devnet-app \
#     --tunnel-through-iap -- -N -L 18080:127.0.0.1:80 -L 17575:127.0.0.1:7575
#
# The Cloud Run backend does NOT use the tunnel: it dials CD_LEDGER_HOST:5001 over Direct
# VPC egress (06-wire-backend.sh fills the VM's internal IP in).
# =============================================================================

CD_NGINX=http://127.0.0.1:18080
# participant JSON API, published on the VM's 127.0.0.1:7575 by node/compose-crossdesk.yaml
CD_JSON_API=http://127.0.0.1:17575

CD_LEDGER_HOST=10.20.0.10              # the VM's reserved INTERNAL address (01-create-vm.sh)
CD_LEDGER_PORT=5001                    # participant gRPC Ledger API, published on the internal IP only
CD_LEDGER_TLS=false                    # private VPC; see README Phase 3 security notes
CD_LEDGER_AUTHORITY=

CD_TOKEN_AUDIENCE=https://ledger-api.crossdesk-devnet.internal
CD_HMAC_SECRET_REF=gsm:crossdesk-ledger-hmac-secret

CD_ADMIN_USER=ledger-api-user
CD_BACKEND_USER=crossdesk-backend
CD_WALLET_USER=administrator           # compose validator's wallet admin (validator operator party)
CD_VALIDATOR_AUDIENCE=https://validator.example.com

CD_PARTY_HINTS="issuer bank alice bob auditor venue agent"
CD_PARTY_SUFFIX=-crossdesk

# DevNet Scan is IP-allowlisted: reachable from the VM, NOT from this laptop (403).
CD_SCAN=https://scan.sv-1.dev.global.canton.network.sync.global
CD_SCAN_HOST=
# BitSafe CBTC registry (public, no auth) — docs/TOKEN_STANDARD_RUNBOOK.md §0
CD_CBTC_REGISTRY=https://api.utilities.digitalasset-dev.com
# Registry base URLs per instrument admin (label=url). The desk appends /registry/... itself.
#  - cbtc-network: the DA Utility registry, path-scoped by registrar. The registrar id below is
#    from 2026-08-04 (pre-reset) — RE-VERIFY after any DevNet reset via
#    https://registry.dev.app.digitalasset.com/config.js and a pending offer's instrumentId.admin.
#  - DSO (Canton Coin): DevNet Scan is IP-allowlisted, so the desk reaches it through the
#    crossdesk-scan-proxy sidecar on the VM (node/compose-crossdesk.yaml), port 5012.
CD_REGISTRY_REMOTE_URLS=cbtc-network=https://api.utilities.digitalasset-dev.com/api/token-standard/v0/registrars/cbtc-network::12202a83c6f4082217c175e29bc53da5f2703ba2675778ab99217a5a881a949203ff,DSO=http://10.20.0.10:5012

CD_BACKEND_URL=https://crossdesk-devnet-api-367745852528.us-central1.run.app
