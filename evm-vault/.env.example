# ---- network / signer -------------------------------------------------------
# Either a mnemonic or a single private key. Never commit a real value.
# MNEMONIC=
DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ETHERSCAN_API_KEY=

# ---- scripts/deploy.ts ------------------------------------------------------
VAULT_NAME=ETP Foundry LX1 Basket
VAULT_SYMBOL=LX1
# Free-form id; the script keccak256s it into the bytes32 instrumentId unless
# you pass a 0x-prefixed 32-byte hex value directly.
INSTRUMENT_ID=LX1
# Comma-separated ERC20 addresses (the tokenised stocks) and, in the same
# order, units per 1e18 shares expressed in each token's OWN base units
# (e.g. 0.5 of a 6-decimal token = 500000).
CONSTITUENTS=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002
UNITS_PER_SHARE=500000,250000000000000000
# Comma-separated attestor addresses and K-of-N threshold (>= 2, <= N).
ATTESTORS=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002,0x0000000000000000000000000000000000000003
NAV_THRESHOLD=2
# Optional: defaults to the deployer.
ADMIN=
FEE_RECIPIENT=
# Comma-separated addresses to grant AP_ROLE (optional).
AP_ADDRESSES=
# Basis points. Caps: create/redeem <= 500, management <= 1000.
CREATE_FEE_BPS=0
REDEEM_FEE_BPS=0
MANAGEMENT_FEE_BPS=0
# Optional holder registry (IHolderRegistry) address.
HOLDER_REGISTRY=

# ---- scripts/post-nav.ts ----------------------------------------------------
VAULT_ADDRESS=
BENCHMARK_ID=LX1
# The vault's instrumentId must equal keccak256(BENCHMARK_ID); the relay refuses
# to post one benchmark into another instrument's vault. INSTRUMENT_ID above
# overrides the expected value if the vault was deployed with a raw bytes32.
ETPFOUNDRY_API_BASE=https://etpfoundry.com/api
# Reference relay only: N local attestor keys, comma-separated. In production
# each committee member signs on their own machine and the relay only collects.
ATTESTOR_PRIVATE_KEYS=
# Pays gas for postNav; defaults to DEPLOYER_PRIVATE_KEY.
RELAYER_PRIVATE_KEY=
# Session code stamped into the fixing (0 = close). The API does not expose one.
NAV_SESSION=0
# Free-form rulebook tag; keccak256'd into bytes32 unless already 0x..32 bytes.
RULEBOOK_VERSION=lx1-rulebook-v1
# Refuse tier-0 ("seed value, not attested") fixings unless explicitly allowed.
ALLOW_SEED_FIXING=false
